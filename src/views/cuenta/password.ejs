<%- include('../partials/page-header', { heading: forced ? 'Elegí una contraseña nueva' : 'Cambiar contraseña', lead: forced ? 'Ingresaste con una contraseña temporal. Para proteger tus datos, reemplazala antes de continuar.' : 'Usá al menos 8 caracteres, con mayúscula, minúscula y número.' }) %>
<div class="card card--narrow">
  <form method="post" action="/cuenta/password" class="form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field<%= errors.actual ? ' has-error' : '' %>">
      <label for="actual"><%= forced ? 'Contraseña temporal' : 'Contraseña actual' %></label>
      <input id="actual" name="actual" type="password" autocomplete="current-password" required>
      <% if (errors.actual) { %><p class="field__error"><%= errors.actual %></p><% } %>
    </div>
    <div class="field<%= errors.nueva ? ' has-error' : '' %>">
      <label for="nueva">Contraseña nueva</label>
      <input id="nueva" name="nueva" type="password" autocomplete="new-password" minlength="8" required aria-describedby="nueva-hint">
      <p class="field__hint" id="nueva-hint">Mínimo 8 caracteres, con mayúscula, minúscula y número.</p>
      <% if (errors.nueva) { %><p class="field__error"><%= errors.nueva %></p><% } %>
    </div>
    <div class="field<%= errors.confirmacion ? ' has-error' : '' %>">
      <label for="confirmacion">Repetí la contraseña nueva</label>
      <input id="confirmacion" name="confirmacion" type="password" autocomplete="new-password" required>
      <% if (errors.confirmacion) { %><p class="field__error"><%= errors.confirmacion %></p><% } %>
    </div>
    <div class="form__actions">
      <button type="submit" class="btn btn--primary">Guardar contraseña</button>
    </div>
  </form>
</div>
