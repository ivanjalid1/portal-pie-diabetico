<%
  // Revisión manual de cada foto del visor: Aprobado / Rechazado / Falta revisar
  // y un comentario. Funciona sin JS (un formulario por foto); public/js/image-review.js
  // guarda sin recargar y marca la foto que se ve en el visor.
  //   study, visor (ThermalViewerService#sources), revision (ImageReviewService#forStudy)
  const ESTADOS = [
    { v: 'aprobado', t: 'Aprobado' },
    { v: 'rechazado', t: 'Rechazado' },
    { v: 'pendiente', t: 'Falta revisar' },
  ];
  const TONO = { aprobado: 'ok', rechazado: 'danger', pendiente: 'muted' };
  const nReps = Object.fromEntries(visor.map((v) => [v.toma, v.reps.length]));
%>
<div class="ir" id="revision" data-ir>
  <div class="ir__head">
    <h3 class="ir__title">Revisión de las fotos</h3>
    <p class="muted small">Aprobá o rechazá cada foto. No cambia el análisis.</p>
  </div>
  <div class="ir__grid">
    <% revision.fotos.forEach((f) => { const id = `revision-t${f.toma}-r${f.replica}`; const g = guardadoTexto(f, fmt); %>
    <form class="ir-item ir-item--<%= f.estado %>" id="<%= id %>" method="post" action="/medico/estudios/<%= study.id %>/visor/<%= f.toma %>/<%= f.replica %>/revision" data-ir-form data-toma="<%= f.toma %>" data-rep="<%= f.replica %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="ir-item__head">
        <span class="ir-item__name"><span class="toma-dot toma-dot--<%= f.toma %>"></span>Toma <%= f.toma %><%= nReps[f.toma] > 1 ? ` · réplica ${f.replica}` : '' %></span>
        <span class="ir-item__live" data-ir-live hidden>En el visor</span>
        <span class="badge badge--<%= TONO[f.estado] %>" data-ir-badge><%= f.etiqueta %></span>
      </div>
      <fieldset class="ir-seg">
        <legend class="sr-only">Estado de la foto (toma <%= f.toma %>, réplica <%= f.replica %>)</legend>
        <% ESTADOS.forEach((e) => { %>
        <label class="ir-seg__opt ir-seg__opt--<%= e.v %>"><input type="radio" name="estado" value="<%= e.v %>"<%= f.estado === e.v ? ' checked' : '' %>><span><%= e.t %></span></label>
        <% }) %>
      </fieldset>
      <label class="sr-only" for="<%= id %>-c">Comentario</label>
      <textarea id="<%= id %>-c" class="ir-item__comment" name="comentario" rows="2" maxlength="1000" placeholder="Comentario (opcional)"><%= f.comentario %></textarea>
      <div class="ir-item__foot">
        <span class="ir-item__saved" data-ir-saved role="status" aria-live="polite"><%= g || 'Sin revisar todavía' %></span>
        <button type="submit" class="btn btn--ghost btn--sm" data-ir-save>Guardar</button>
      </div>
    </form>
    <% }) %>
  </div>
</div>
<script src="/js/image-review.js" defer></script>
