<% if (analysis) { const cat = domain.RISK_CATEGORIES[analysis.categoria]; const conPct = typeof showPct !== 'undefined' && showPct && !(analysis.puntual && analysis.puntual.categoriaPor === 'hallazgo_termico'); %>
<span class="badge badge--<%= cat.tono %>"><span class="dot" aria-hidden="true"></span><%= typeof patientView !== 'undefined' && patientView ? cat.paciente : cat.nombre %><% if (conPct) { %> <span class="num"><%= pw.riesgoPct(analysis.probabilidad) %></span><% } %></span>
<% } else { %>
<span class="badge badge--muted">Sin resultado</span>
<% } %>
