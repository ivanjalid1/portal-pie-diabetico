<%
  // Revisión manual de las fotos (médico/a y administrador/a): grilla de todas
  // las fotos del visor agrupadas por paciente y toma, con Aprobado /
  // Rechazado / Falta revisar y un comentario. Sin JS cada foto es un
  // formulario (POST y vuelta a esta página); public/js/image-review.js guarda
  // sin recargar, actualiza el progreso y agrega los atajos de teclado.
  // Sólo se muestra el código del paciente (nunca nombre ni DNI).
  const ESTADOS = [
    { v: 'aprobado', t: 'Aprobado', k: 'A' },
    { v: 'rechazado', t: 'Rechazado', k: 'R' },
    { v: 'pendiente', t: 'Falta revisar', k: 'P' },
  ];
  const TONO = { aprobado: 'ok', rechazado: 'danger', pendiente: 'muted' };
  const qs = (over = {}) => {
    const p = new URLSearchParams();
    const base = { estado: filtro, q, pagina: page };
    Object.entries({ ...base, ...over }).forEach(([k, v]) => {
      if (v !== undefined && v !== '' && v !== null && !(k === 'pagina' && Number(v) === 1)) p.set(k, v);
    });
    const s = p.toString();
    return s ? `?${s}` : '';
  };
  const pct = resumen.total ? Math.round((resumen.revisadas / resumen.total) * 100) : 0;
  const hayFoto = fotos.some((f) => f.foto);
%>
<%- include('../partials/page-header', {
  heading: 'Revisión de fotos',
  lead: user.role === 'admin'
    ? 'Todas las fotos de los estudios. Aprobá o rechazá cada una; no cambia el análisis.'
    : 'Las fotos de los estudios de tus pacientes. Aprobá o rechazá cada una; no cambia el análisis.',
}) %>

<section class="card rv-progress" aria-label="Progreso de la revisión">
  <div class="rv-progress__main">
    <p class="rv-progress__count"><strong class="num" data-rv-revisadas><%= resumen.revisadas %></strong> de <span class="num" data-rv-total><%= resumen.total %></span> revisadas</p>
    <div class="rv-bar" role="progressbar" aria-label="Fotos revisadas" aria-valuemin="0" aria-valuemax="<%= resumen.total %>" aria-valuenow="<%= resumen.revisadas %>" data-rv-bar>
      <span class="rv-bar__ok" style="width: <%= resumen.total ? (resumen.aprobado / resumen.total) * 100 : 0 %>%" data-rv-bar-ok></span><span class="rv-bar__bad" style="width: <%= resumen.total ? (resumen.rechazado / resumen.total) * 100 : 0 %>%" data-rv-bar-bad></span>
    </div>
  </div>
  <ul class="rv-progress__legend small">
    <li><span class="rv-dot rv-dot--ok" aria-hidden="true"></span><span class="num" data-rv-n="aprobado"><%= resumen.aprobado %></span> aprobadas</li>
    <li><span class="rv-dot rv-dot--bad" aria-hidden="true"></span><span class="num" data-rv-n="rechazado"><%= resumen.rechazado %></span> rechazadas</li>
    <li><span class="rv-dot" aria-hidden="true"></span><span class="num" data-rv-n="pendiente"><%= resumen.pendiente %></span> por revisar</li>
    <li class="muted"><span class="num" data-rv-pct><%= pct %></span> %</li>
  </ul>
</section>

<div class="rv-toolbar">
  <nav class="rv-filters" aria-label="Filtrar fotos">
    <% FILTROS.forEach((k) => { const on = k === filtro; %>
    <a class="rv-filter<%= on ? ' is-active' : '' %>" href="/revision<%= qs({ estado: k, pagina: 1 }) %>"<%- on ? ' aria-current="page"' : '' %>><%= FILTRO_LABELS[k] %> <span class="num" data-rv-c="<%= k %>"><%= conteos[k] %></span></a>
    <% }) %>
  </nav>
  <form class="rv-search input-icon" method="get" action="/revision" role="search">
    <%- include('../partials/icon', { name: 'search', size: 18 }) %>
    <input type="hidden" name="estado" value="<%= filtro %>">
    <label for="rv-q" class="sr-only">Buscar por código de paciente</label>
    <input id="rv-q" name="q" type="search" value="<%= q %>" placeholder="Código de paciente" maxlength="40">
  </form>
</div>

<div class="rv-help">
  <% if (hayFoto) { %>
  <label class="rv-switch"><input type="checkbox" data-rv-visible><span>Mostrar la foto visible</span></label>
  <% } %>
  <p class="small muted rv-help__keys">Elegir un estado guarda al instante. Atajos: <kbd>A</kbd> aprobar · <kbd>R</kbd> rechazar · <kbd>P</kbd> falta revisar · <kbd>J</kbd>/<kbd>K</kbd> siguiente/anterior<% if (hayFoto) { %> · <kbd>V</kbd> foto visible<% } %> · <kbd>C</kbd> comentario · <kbd>Ctrl</kbd>+<kbd>Enter</kbd> guardar comentario. Hacé clic en la imagen para abrir el visor.</p>
</div>

<p class="result-count muted small"><strong class="num"><%= totalFiltrado %></strong> <%= totalFiltrado === 1 ? 'foto' : 'fotos' %> <%= filtro === 'todas' ? '' : `· ${FILTRO_LABELS[filtro].toLowerCase()}` %><%= q ? ` · código «${q}»` : '' %></p>

<% if (!grupos.length) { %>
<div class="card"><div class="empty"><%- include('../partials/icon', { name: 'check', size: 28 }) %>
  <h2><%= filtro === 'pendiente' && !q ? 'No quedan fotos por revisar' : 'No hay fotos con este filtro' %></h2>
  <p><a href="/revision<%= qs({ estado: 'todas', q: '', pagina: 1 }) %>">Ver todas las fotos</a></p>
</div></div>
<% } else { %>
<div class="rv-groups" data-rv data-rv-filtro="<%= filtro %>">
  <% grupos.forEach((g) => { const gid = `grupo-${g.key}`; %>
  <section class="rv-group" aria-labelledby="<%= gid %>">
    <header class="rv-group__head">
      <h2 class="rv-group__title" id="<%= gid %>"><span class="toma-dot toma-dot--<%= g.toma %>" aria-hidden="true"></span><%= g.codigo %> · Toma <%= g.toma %></h2>
      <span class="muted small num"><%= fmt.date(g.fechaToma) %></span>
      <% if (g.fotos[0].calidadBaja) { %><span class="badge badge--warn">Calidad baja de la toma</span><% } %>
      <a class="rv-group__link small" href="<%= studyHref(g.fotos[0]) %>">Abrir en el visor</a>
    </header>
    <div class="rv-grid">
      <% g.fotos.forEach((f) => {
        const id = `foto-${f.studyId}-${f.toma}-${f.replica}`;
        const base = `/revision/estudios/${f.studyId}/visor/${f.toma}/${f.replica}`;
        const nombre = `${f.codigo}, toma ${f.toma}${f.nReps > 1 ? `, réplica ${f.replica}` : ''}`;
        const saved = guardadoTexto(f, fmt);
      %>
      <article class="rv-tile rv-tile--<%= f.estado %>" id="<%= id %>" data-rv-tile tabindex="-1" aria-label="Foto <%= nombre %>">
        <a class="rv-tile__media" href="<%= studyHref(f) %>" title="Abrir en el visor">
          <img class="rv-tile__img" src="<%= base %>/miniatura.png" alt="Térmica: <%= nombre %>" width="240" height="180" loading="lazy" decoding="async" data-rv-ir>
          <% if (f.foto) { %><img class="rv-tile__img" data-src="<%= base %>/foto.jpg" alt="Foto visible: <%= nombre %>" width="240" height="180" decoding="async" hidden data-rv-vis><% } %>
          <span class="rv-tile__tags">
            <% if (f.nReps > 1) { %><span class="rv-tag">R<%= f.replica %></span><% } %>
            <% if (f.mejor && f.nReps > 1) { %><span class="rv-tag rv-tag--best">Mejor</span><% } %>
            <% if (f.enPromedio) { %><span class="rv-tag">En promedio</span><% } %>
          </span>
        </a>
        <form class="rv-form" method="post" action="<%= base %>/revision" data-ir-form data-estado="<%= f.estado %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="volver" value="<%= backUrl %>#<%= id %>">
          <div class="rv-form__head">
            <span class="rv-form__name"><%= f.nReps > 1 ? `Réplica ${f.replica}` : 'Única foto' %></span>
            <span class="badge badge--<%= TONO[f.estado] %>" data-ir-badge><%= f.etiqueta %></span>
          </div>
          <% if (f.avisos.length) { %>
          <ul class="rv-avisos" aria-label="Avisos automáticos">
            <% f.avisos.forEach((a) => { %><li class="rv-aviso<%= a.grave ? ' rv-aviso--grave' : '' %>"><%= a.label %></li><% }) %>
          </ul>
          <% } %>
          <fieldset class="ir-seg">
            <legend class="sr-only">Estado de la foto <%= nombre %></legend>
            <% ESTADOS.forEach((e) => { %>
            <label class="ir-seg__opt ir-seg__opt--<%= e.v %>"><input type="radio" name="estado" value="<%= e.v %>"<%= f.estado === e.v ? ' checked' : '' %>><span><%= e.t %></span></label>
            <% }) %>
          </fieldset>
          <label class="sr-only" for="<%= id %>-c">Comentario</label>
          <textarea id="<%= id %>-c" class="rv-form__comment" name="comentario" rows="2" maxlength="1000" placeholder="Comentario (opcional)"><%= f.comentario %></textarea>
          <div class="rv-form__foot">
            <span class="rv-form__saved" data-ir-saved role="status" aria-live="polite"><%= saved || 'Sin revisar todavía' %></span>
            <button type="submit" class="btn btn--ghost btn--sm" data-ir-save>Guardar</button>
          </div>
        </form>
      </article>
      <% }) %>
    </div>
  </section>
  <% }) %>
</div>
<% if (pages > 1) { %>
<nav class="pager" aria-label="Paginación">
  <% if (page > 1) { %><a class="btn btn--ghost btn--sm" href="/revision<%= qs({ pagina: page - 1 }) %>"><%- include('../partials/icon', { name: 'chevronLeft', size: 16 }) %>Anterior</a><% } else { %><span></span><% } %>
  <span class="small muted">Página <span class="num"><%= page %></span> de <span class="num"><%= pages %></span></span>
  <% if (page < pages) { %><a class="btn btn--ghost btn--sm" href="/revision<%= qs({ pagina: page + 1 }) %>" data-rv-next-page>Siguiente<%- include('../partials/icon', { name: 'chevronRight', size: 16 }) %></a><% } else { %><span></span><% } %>
</nav>
<% } %>
<% } %>
<script src="/js/image-review.js" defer></script>
