<%
  // Mapa plantar esquemático: ambos pies vistos desde la planta (como la cámara),
  // con la misma orientación que el termograma. Cada ROI se colorea por |ΔT|.
  const byKey = {};
  (rois || []).forEach((r) => { byKey[r.roi] = r; });
  const u = typeof umbral === 'undefined' ? domain.DELTA_T_UMBRAL : umbral;
  const uid = typeof mapId === 'undefined' ? 'pm' : mapId;
  const showValues = typeof values === 'undefined' ? true : values;
  const shapes = {
    dedo_mayor: '<ellipse cx="140" cy="58" rx="21" ry="29"/>',
    dedos_menores: '<circle cx="104" cy="44" r="12.5"/><circle cx="79" cy="52" r="11.5"/><circle cx="58" cy="63" r="10.5"/><circle cx="42" cy="78" r="9.5"/>',
    // Las regiones de la planta se recortan con el contorno del pie (clipPath),
    // por eso sólo importan sus límites internos, que siguen curvas suaves.
    metatarso: '<path d="M0 80 H200 V160 C 150 176 60 178 0 166 Z"/>',
    arco_interno: '<path d="M200 160 C 150 176 118 177 104 177 C 112 215 113 260 104 303 C 128 301 160 298 200 300 Z"/>',
    arco_externo: '<path d="M0 166 C 40 174 80 177 104 177 C 112 215 113 260 104 303 C 70 305 30 302 0 298 Z"/>',
    talon: '<path d="M0 298 C 30 302 70 305 104 303 C 128 301 160 298 200 300 V420 H0 Z"/>',
  };
  const labelPos = {
    dedo_mayor: [140, 62], dedos_menores: [70, 26], metatarso: [98, 132],
    arco_interno: [119, 240], arco_externo: [70, 240], talon: [94, 352],
  };
  // Etiquetas que quedan fuera del pie se dibujan con el color del texto.
  const outside = ['dedos_menores'];
  const outline = 'M95 394 C 62 394 46 368 45 332 C 44 292 40 252 36 212 C 32 172 30 142 36 118 C 44 96 70 90 100 90 C 135 90 160 100 165 125 C 170 152 150 178 140 205 C 130 232 131 262 139 296 C 147 332 140 394 95 394 Z';
  const feet = [
    // Convención del equipo (como se ve el termograma): pie IZQUIERDO a la izquierda.
    { side: 'izq', label: 'Pie izquierdo', transform: 'translate(8 18)' },
    { side: 'der', label: 'Pie derecho', transform: 'translate(392 18) scale(-1 1)' },
  ];
%>
<figure class="plantar-map">
  <svg viewBox="0 0 400 430" role="img" aria-labelledby="<%= uid %>-title <%= uid %>-desc">
    <title id="<%= uid %>-title">Mapa plantar esquemático por región de interés</title>
    <desc id="<%= uid %>-desc">Ambos pies vistos desde la planta. El color de cada región indica la diferencia de temperatura entre pies (ΔT); las regiones con contorno marcado superan el umbral de <%= fmt.num(u, 1) %> °C.</desc>
    <defs>
      <clipPath id="<%= uid %>-clip"><path d="<%= outline %>"/></clipPath>
      <filter id="<%= uid %>-shadow" x="-20%" y="-10%" width="140%" height="130%"><feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#0b1a24" flood-opacity="0.22"/></filter>
    </defs>
    <% feet.forEach((foot) => { %>
    <g transform="<%= foot.transform %>">
      <path d="<%= outline %>" class="pm-sole" filter="url(#<%= uid %>-shadow)"/>
      <g clip-path="url(#<%= uid %>-clip)">
        <% Object.keys(shapes).filter((k) => k !== 'dedo_mayor' && k !== 'dedos_menores').forEach((k) => {
             const r = byKey[k]; const d = r ? r.deltaT : 0; const hot = Math.abs(d) >= u; %>
        <g class="pm-roi<%= hot ? ' is-hot' : '' %>" fill="<%= thermal.deltaColor(d) %>"><title><%= domain.ROI_NAMES[k] %>: ΔT <%= fmt.signed(d, 2) %> °C</title><%- shapes[k] %></g>
        <% }) %>
      </g>
      <% ['dedo_mayor', 'dedos_menores'].forEach((k) => {
           const r = byKey[k]; const d = r ? r.deltaT : 0; const hot = Math.abs(d) >= u; %>
      <g class="pm-roi<%= hot ? ' is-hot' : '' %>" fill="<%= thermal.deltaColor(d) %>"><title><%= domain.ROI_NAMES[k] %>: ΔT <%= fmt.signed(d, 2) %> °C</title><%- shapes[k] %></g>
      <% }) %>
      <path d="<%= outline %>" class="pm-outline"/>
    </g>
    <% if (showValues) { %>
    <% Object.keys(labelPos).forEach((k) => {
         const r = byKey[k]; if (!r) return;
         const [lx, ly] = labelPos[k];
         const x = foot.side === 'izq' ? 8 + lx : 392 - lx;
         const fill = thermal.deltaColor(r.deltaT); %>
    <text x="<%= x %>" y="<%= 18 + ly %>" class="pm-value<%= outside.includes(k) ? ' pm-value--outside' : '' %>"<%- outside.includes(k) ? '' : ` fill="${thermal.inkOn(fill)}"` %> text-anchor="middle"><%= foot.side === 'der' ? fmt.num(r.avgDer, 1) : fmt.num(r.avgIzq, 1) %></text>
    <% }) %>
    <% } %>
    <text x="<%= foot.side === 'izq' ? 103 : 297 %>" y="428" class="pm-foot-label" text-anchor="middle"><%= foot.label %></text>
    <% }) %>
  </svg>
  <figcaption class="pm-legend">
    <span>|ΔT| 0 °C</span>
    <span class="pm-legend__bar" aria-hidden="true" style="background: <%= thermal.DELTA_LEGEND_CSS %>"></span>
    <span>3 °C</span>
    <span class="pm-legend__note">Contorno marcado: |ΔT| ≥ <%= fmt.num(u, 1) %> °C.<% if (showValues) { %> Números: temperatura media de la región (°C).<% } %></span>
  </figcaption>
</figure>
