<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= appName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Bricolage+Grotesque:opsz,wght@12..96,500..800&display=swap">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/print.css">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <script src="/js/report.js" defer></script>
  <script src="/js/pointwise.js" defer></script>
</head>
<body class="report">
  <div class="report__toolbar no-print">
    <button type="button" class="btn btn--primary" data-print><%- include('../partials/icon', { name: 'printer', size: 18 }) %>Imprimir o guardar como PDF</button>
    <a class="btn btn--ghost" href="/medico/estudios/<%= study.id %>">Volver al estudio</a>
  </div>
  <% const a = analysis; const s = study; const p = patient; %>
  <article class="report__page">
    <header class="report__head">
      <div class="brand"><img src="/img/logo.svg" alt="" width="36" height="36"><span class="brand__text"><strong><%= appName %></strong><small><%= domain.PROJECT.facultad %>, <%= domain.PROJECT.universidad %></small></span></div>
      <div class="report__meta">
        <strong>Informe de termografía plantar</strong>
        <span>Generado el <%= fmt.dateTime(generado) %></span>
      </div>
    </header>

    <section class="report__grid">
      <dl class="kv kv--compact">
        <div><dt>Paciente</dt><dd><strong><%= p.codigo %></strong>, <%= p.nombreCompleto %></dd></div>
        <div><dt>Edad / sexo</dt><dd><%= p.edad(new Date(s.fechaHora)) ?? '—' %> años, <%= p.sexo || '—' %></dd></div>
        <div><dt>Diabetes</dt><dd>Tipo <%= p.tipoDm %>, <%= fmt.num(p.aniosEvolucionDm, 1) %> años<%= p.insulinorequiriente ? ', insulinorequiriente' : '' %></dd></div>
        <div><dt>HbA1c</dt><dd><%= p.hba1c !== null ? `${fmt.num(p.hba1c, 1)} % (${fmt.date(p.hba1cFecha)})` : '—' %></dd></div>
        <div><dt>Neuropatía</dt><dd><%= p.gradoNeuropatia %></dd></div>
      </dl>
      <dl class="kv kv--compact">
        <div><dt>Toma 1 (basal)</dt><dd><%= fmt.date(s.fechaToma1) %></dd></div>
        <div><dt>Toma 2 (control)</dt><dd><%= a && a.puntual && !a.puntual.tieneToma2 ? 'Sin toma 2' : fmt.date(s.fechaHora) + (s.diasEntreTomas !== null ? ` (${s.diasEntreTomas} días)` : '') %></dd></div>
        <div><dt>Centro</dt><dd><%= s.centro %></dd></div>
        <div><dt>Médico/a</dt><dd><%= medico.nombreCompleto %><%= medico.matricula ? `, ${medico.matricula}` : '' %></dd></div>
        <div><dt>Ambiente</dt><dd><%= s.tempAmbiente === null ? 'Sin registro' : `${fmt.num(s.tempAmbiente, 1)} °C, HR ${fmt.num(s.humedadRelativa, 0)} % ${s.condiciones(paramsOf(a).protocolo).ok ? '(dentro del protocolo)' : '(fuera del protocolo)'}` %></dd></div>
        <div><dt>Imagen</dt><dd><%= s.valida ? 'Válida' : `No válida: ${s.motivoInvalidez || ''}` %></dd></div>
      </dl>
    </section>

    <% if (a) { const PW = a.puntual; const MOD = PW && PW.modelo; const tA = a.puntualActual; const mA = tA && tA.metricas; const lectura = PW && tA ? pw.lecturaToma(tA, PW.umbralPixel) : null; const cambio = PW && PW.tieneToma2 ? pw.cambioArea(a) : null; %>
    <section class="report__summary">
      <h2>Resultado<% if (tA) { %> (toma <%= tA.toma %>)<% } %></h2>
      <% if (mA) { %><p><span class="badge badge--<%= tA.conAsimetria ? 'danger' : 'ok' %>"><%= tA.conAsimetria ? 'Asimetría térmica' : 'Sin asimetría relevante' %></span></p><% } %>
      <% if (lectura) { %>
      <p class="report__lead"><%= lectura.frase %><% if (cambio) { %> <%= cambio.frase %><% } %></p>
      <% } else if (!PW) { %>
      <p class="report__lead">No se pudo hacer el análisis punto a punto porque las imágenes no son archivos radiométricos (.IS2).</p>
      <% } %>
    </section>
    <section class="report__result">
      <% if (mA) { %>
      <div class="report__big">
        <span class="label">Planta con diferencia &gt; <%= fmt.num(PW.umbralPixel, 1) %> °C</span>
        <span class="num report__pct"><%= fmt.num(mA.areaCalientePct, 0) %> %</span>
      </div>
      <div class="report__big">
        <span class="label">Diferencia máxima</span>
        <span class="num report__pct"><%= fmt.num(mA.maxAbs, 1) %> °C</span>
        <span>En <%= pw.ZONA_CON_ARTICULO[mA.hotspot.zona] %>, más caliente el pie <%= mA.hotspot.pieMasCaliente %></span>
      </div>
      <% } %>
      <div class="report__big">
        <span class="label">Tomas</span>
        <span><%= PW && !PW.tieneToma2 ? 'Sólo toma 1 (sin toma 2)' : 'Toma 1 y toma 2' %></span>
        <% if (cambio) { %><span>Cambio del área: <span class="num"><%= fmt.signed(cambio.delta, 0) %> pts</span></span><% } %>
        <% PW && PW.tomas.forEach((t) => { if (t.zonasNoAnalizadas.length) { %><span>Toma <%= t.toma %>: <%= pw.noAnalizadoTexto(t) %></span><% } }) %>
      </div>
    </section>
    <p class="small report__model">Modelo preliminar · no validado: <span class="num"><%= fmt.num(a.probabilidad, 0) %> %</span><% if (MOD) { %> (probabilidad de HbA1c &gt; 7 %, desenlace sustituto; AUC <%= fmt.num(MOD.auc, 2) %>, n = <%= MOD.n %>: todavía no discrimina)<% } else { %> (simulado)<% } %>.</p>

    <% if (PW) { const data = pw.payload(a); const srcId = `pw-rep-${s.id}`; %>
    <script type="application/json" id="<%= srcId %>" data-pw-data><%- pw.json(data) %></script>
    <section>
      <h2>Mapas punto a punto</h2>
      <div class="report__pwmaps">
        <% PW.tomas.forEach((t) => { %>
        <figure class="pw-map pw-map--dt"><canvas data-pw-map="<%= t.toma %>:dt" data-pw-src="<%= srcId %>"></canvas><figcaption>Diferencia izq. − der. · toma <%= t.toma %></figcaption></figure>
        <% }) %>
        <% if (PW.cambio) { %>
        <figure class="pw-map"><canvas data-pw-map="cambio:izq" data-pw-src="<%= srcId %>"></canvas><figcaption>Cambio T2 − T1 · pie izq.</figcaption></figure>
        <figure class="pw-map"><canvas data-pw-map="cambio:der" data-pw-src="<%= srcId %>"></canvas><figcaption>Cambio T2 − T1 · pie der.</figcaption></figure>
        <% } %>
      </div>
      <div class="report__scale"><%- include('../partials/scale', { gradient: 'linear-gradient(90deg, #2563a6 0%, #9dbbe0 30%, #f7f7f7 50%, #eba59f 70%, #d0342c 100%)', ticks: [-3, -2, -1, 0, 1, 2, 3].map((v) => [(v + 3) / 6, v > 0 ? `+${v}` : v < 0 ? `−${-v}` : '0']), marks: PW.umbralPixel < 3 ? [(3 - PW.umbralPixel) / 6, (3 + PW.umbralPixel) / 6] : [], ends: ['der. más caliente', 'izq. más caliente'], label: 'Escala de diferencia de −3 a +3 °C' }) %></div>
      <p class="small">Diferencia = izquierdo − derecho espejado: rojo, el izquierdo más caliente; azul, el derecho (escala ±3 °C). Contorno y marcas de la escala: más de <%= fmt.num(PW.umbralPixel, 1) %> °C de diferencia; rayado: zona sin par; círculo: mayor diferencia.<% if (PW.cambio) { %> Mapas de cambio centrados en el cambio mediano de cada pie (izq. <%= fmt.signed(PW.cambio.izq && PW.cambio.izq.mediana, 1) %> °C, der. <%= fmt.signed(PW.cambio.der && PW.cambio.der.mediana, 1) %> °C): rojo, la zona se calentó más que el resto del pie.<% } %></p>
      <div class="table-wrap">
      <table class="table table--num table--dense">
        <thead><tr><th scope="col">Toma</th><th scope="col">Área &gt; umbral</th><th scope="col">|ΔT| medio</th><th scope="col">|ΔT| p95</th><th scope="col">|ΔT| máx.</th><th scope="col">Mayor diferencia</th></tr></thead>
        <tbody>
          <% PW.tomas.forEach((t) => { const m = t.metricas; %>
          <tr class="<%= t.conAsimetria ? 'row-hot' : '' %>"><th scope="row" class="nowrap">Toma <%= t.toma %></th><td><%= m ? fmt.num(m.areaCalientePct, 1) + ' %' : '—' %></td><td><%= m ? fmt.num(m.mediaAbs, 2) : '—' %></td><td><%= m ? fmt.num(m.p95Abs, 2) : '—' %></td><td><%= m ? fmt.num(m.maxAbs, 2) : '—' %></td><td><%= pw.hotspotTexto(m) %></td></tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </section>
    <% } %>
    <% } %>

    <section class="report__images">
      <% imageSlots.forEach((sl) => { const img = s.image(sl.slot); if (img && canPreview(img)) { %>
      <figure><img src="<%= imageUrl(s, sl.slot) %>" alt="<%= slotTitulo(sl) %>"><figcaption><%= slotTitulo(sl) %></figcaption></figure>
      <% } }) %>
    </section>

    <% if (s.notasMedico) { %>
    <section><h2>Notas del médico</h2><p><%= s.notasMedico %></p></section>
    <% } %>

    <footer class="report__foot">
      <p>Análisis <%= a ? a.predictorVersion : '—' %><%= a && a.puntual && a.puntual.modelo ? ` · modelo preliminar ${a.puntual.modelo.version}, no validado` : '' %>.</p>
      <p>Documento con datos de salud: tratamiento confidencial según Ley 25.326 y Ley 26.529.</p>
      <div class="report__sign"><span>Firma y sello</span></div>
    </footer>
  </article>
</body>
</html>
