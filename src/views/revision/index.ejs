<%
  // Revisión manual por TOMA (médico/a y administrador/a): una tarjeta por toma
  // con todas sus fotos (réplicas) lado a lado. Por toma se usa UNA foto: la
  // elegida aquí («Usar esta») o la sugerida automáticamente. Además, el estado
  // de la toma (Aprobada / Rechazada / Falta revisar) y un comentario. Sin JS
  // cada toma es un formulario (POST y vuelta a esta página);
  // public/js/image-review.js guarda sin recargar, actualiza el progreso y
  // agrega los atajos de teclado. Sólo se muestra el código del paciente.
  const ESTADOS = [
    { v: 'aprobado', t: 'Aprobada', k: 'A' },
    { v: 'rechazado', t: 'Rechazada', k: 'R' },
    { v: 'pendiente', t: 'Falta revisar', k: 'P' },
  ];
  const TONO = { aprobado: 'ok', rechazado: 'danger', pendiente: 'muted' };
  const qs = (over = {}) => {
    const p = new URLSearchParams();
    const base = { estado: filtro, q, pagina: page };
    Object.entries({ ...base, ...over }).forEach(([k, v]) => {
      if (v !== undefined && v !== '' && v !== null && !(k === 'pagina' && Number(v) === 1)) p.set(k, v);
    });
    const s = p.toString();
    return s ? `?${s}` : '';
  };
  const pct = resumen.total ? Math.round((resumen.revisadas / resumen.total) * 100) : 0;
  const hayFoto = tomas.some((t) => t.reps.some((r) => r.foto));
%>
<%- include('../partials/page-header', {
  heading: 'Revisión de fotos',
  lead: (user.role === 'admin' ? 'Todas las tomas de los estudios.' : 'Las tomas de los estudios de tus pacientes.') + ' En cada toma se usa una sola foto: elegí cuál y marcá la toma.',
}) %>

<section class="card rv-progress" aria-label="Progreso de la revisión">
  <div class="rv-progress__main">
    <p class="rv-progress__count"><strong class="num" data-rv-revisadas><%= resumen.revisadas %></strong> de <span class="num" data-rv-total><%= resumen.total %></span> tomas revisadas</p>
    <div class="rv-bar" role="progressbar" aria-label="Tomas revisadas" aria-valuemin="0" aria-valuemax="<%= resumen.total %>" aria-valuenow="<%= resumen.revisadas %>" data-rv-bar>
      <span class="rv-bar__ok" style="width: <%= resumen.total ? (resumen.aprobado / resumen.total) * 100 : 0 %>%" data-rv-bar-ok></span><span class="rv-bar__bad" style="width: <%= resumen.total ? (resumen.rechazado / resumen.total) * 100 : 0 %>%" data-rv-bar-bad></span>
    </div>
  </div>
  <ul class="rv-progress__legend small">
    <li><span class="rv-dot rv-dot--ok" aria-hidden="true"></span><span class="num" data-rv-n="aprobado"><%= resumen.aprobado %></span> aprobadas</li>
    <li><span class="rv-dot rv-dot--bad" aria-hidden="true"></span><span class="num" data-rv-n="rechazado"><%= resumen.rechazado %></span> rechazadas</li>
    <li><span class="rv-dot" aria-hidden="true"></span><span class="num" data-rv-n="pendiente"><%= resumen.pendiente %></span> por revisar</li>
    <li class="muted"><span class="num" data-rv-pct><%= pct %></span> %</li>
    <li class="rv-progress__mask" title="Contornos de los pies corregidos a mano: sirven para evaluar y reentrenar la segmentación automática."><span class="num" data-rv-contornos><%= contornos %></span> <%= contornos === 1 ? 'contorno corregido' : 'contornos corregidos' %> <span class="muted">(meta <%= META_CONTORNOS.min %>–<%= META_CONTORNOS.max %>)</span></li>
  </ul>
</section>

<div class="rv-toolbar">
  <nav class="rv-filters" aria-label="Filtrar tomas">
    <% FILTROS.forEach((k) => { const on = k === filtro; %>
    <a class="rv-filter<%= on ? ' is-active' : '' %>" href="/revision<%= qs({ estado: k, pagina: 1 }) %>"<%- on ? ' aria-current="page"' : '' %>><%= FILTRO_LABELS[k] %> <span class="num" data-rv-c="<%= k %>"><%= conteos[k] %></span></a>
    <% }) %>
  </nav>
  <form class="rv-search input-icon" method="get" action="/revision" role="search">
    <%- include('../partials/icon', { name: 'search', size: 18 }) %>
    <input type="hidden" name="estado" value="<%= filtro %>">
    <label for="rv-q" class="sr-only">Buscar por código de paciente</label>
    <input id="rv-q" name="q" type="search" value="<%= q %>" placeholder="Código de paciente" maxlength="40">
  </form>
</div>

<div class="rv-help">
  <% if (hayFoto) { %>
  <label class="rv-switch"><input type="checkbox" data-rv-visible><span>Mostrar la foto visible</span></label>
  <% } %>
  <p class="small muted rv-help__keys">Elegir una foto o un estado guarda al instante; cambiar la foto vuelve a calcular el resultado del estudio. Atajos: <kbd>1</kbd>–<kbd>9</kbd> usar esa foto · <kbd>A</kbd> aprobar · <kbd>R</kbd> rechazar · <kbd>P</kbd> falta revisar · <kbd>J</kbd>/<kbd>K</kbd> siguiente/anterior<% if (hayFoto) { %> · <kbd>V</kbd> foto visible<% } %> · <kbd>C</kbd> comentario · <kbd>Ctrl</kbd>+<kbd>Enter</kbd> guardar comentario.</p>
</div>

<p class="result-count muted small"><strong class="num"><%= totalFiltrado %></strong> <%= totalFiltrado === 1 ? 'toma' : 'tomas' %> <%= filtro === 'todas' ? '' : `· ${FILTRO_LABELS[filtro].toLowerCase()}` %><%= q ? ` · código «${q}»` : '' %></p>

<% if (!tomas.length) { %>
<div class="card"><div class="empty"><%- include('../partials/icon', { name: 'check', size: 28 }) %>
  <h2><%= filtro === 'pendiente' && !q ? 'No quedan tomas por revisar' : 'No hay tomas con este filtro' %></h2>
  <p><a href="/revision<%= qs({ estado: 'todas', q: '', pagina: 1 }) %>">Ver todas las tomas</a></p>
</div></div>
<% } else { %>
<div class="rv-groups" data-rv data-rv-filtro="<%= filtro %>">
  <% tomas.forEach((t) => {
    const id = `toma-${t.studyId}-${t.toma}`;
    const nombre = `${t.codigo}, toma ${t.toma}`;
    const base = `/revision/estudios/${t.studyId}/visor/${t.toma}`;
    const saved = guardadoTexto(t, fmt);
  %>
  <article class="rv-toma rv-toma--<%= t.estado %>" id="<%= id %>" data-rv-tile tabindex="-1" aria-labelledby="<%= id %>-h">
    <form class="rv-form" method="post" action="/revision/estudios/<%= t.studyId %>/tomas/<%= t.toma %>/revision" data-ir-form data-estado="<%= t.estado %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="volver" value="<%= backUrl %>#<%= id %>">
      <header class="rv-toma__head">
        <h2 class="rv-group__title" id="<%= id %>-h"><span class="toma-dot toma-dot--<%= t.toma %>" aria-hidden="true"></span><%= t.codigo %> · Toma <%= t.toma %></h2>
        <span class="muted small num"><%= fmt.date(t.fechaToma) %></span>
        <% if (t.calidadBaja) { %><span class="badge badge--warn">Calidad baja</span><% } %>
        <span class="badge badge--<%= TONO[t.estado] %>" data-ir-badge><%= t.etiqueta %></span>
        <a class="rv-group__link small" href="<%= studyHref(t) %>" data-rv-visor>Abrir en el visor</a>
      </header>

      <fieldset class="rv-reps">
        <legend class="rv-reps__legend"><span>Foto que se usa en el análisis</span> <span class="muted small" data-rv-usada><%= t.usadaTexto %></span></legend>
        <div class="rv-reps__grid">
          <% t.reps.forEach((r, i) => { const rid = `${id}-r${r.rep}`; const graves = r.avisos.filter((a) => a.grave).length; %>
          <label class="rv-rep<%= r.usada ? ' is-used' : '' %>" for="<%= rid %>" data-rv-rep="<%= r.rep %>">
            <span class="rv-rep__media">
              <img class="rv-tile__img" src="<%= base %>/<%= r.rep %>/miniatura.png" alt="Térmica: <%= nombre %>, foto <%= r.rep %>" width="240" height="180" loading="lazy" decoding="async" data-rv-ir>
              <% if (r.foto) { %><img class="rv-tile__img" data-src="<%= base %>/<%= r.rep %>/foto.jpg" alt="Foto visible: <%= nombre %>, foto <%= r.rep %>" width="240" height="180" decoding="async" hidden data-rv-vis><% } %>
              <span class="rv-tile__tags">
                <span class="rv-tag"><% if (i < 9) { %><span class="rv-tag__key" aria-hidden="true"><%= i + 1 %></span><% } %>Foto <%= r.rep %></span>
                <% if (r.sugerida && t.reps.length > 1) { %><span class="rv-tag rv-tag--best">Sugerida</span><% } %>
              </span>
            </span>
            <span class="rv-rep__body">
              <% if (r.avisos.length) { %>
              <span class="rv-avisos" aria-label="Avisos automáticos">
                <% r.avisos.forEach((a) => { %><span class="rv-aviso<%= a.grave ? ' rv-aviso--grave' : '' %>"><%= a.label %></span><% }) %>
              </span>
              <% } else { %>
              <span class="rv-avisos"><span class="rv-aviso rv-aviso--ok">Sin avisos</span></span>
              <% } %>
              <% if (r.contorno) { %><span class="rv-contorno small" data-rv-contorno>Contorno corregido por <%= r.contorno.por %></span><% } %>
              <span class="rv-rep__pick">
                <input type="radio" id="<%= rid %>" name="replica" value="<%= r.rep %>"<%= r.usada ? ' checked' : '' %> data-rv-pick aria-describedby="<%= rid %>-d">
                <span class="rv-rep__pick-text">Usar esta</span>
              </span>
              <% if (t.origen === 'real') { %><a class="rv-rep__mask small" href="<%= contornoHref(t, r.rep) %>">Corregir contorno</a><% } %>
              <span class="sr-only" id="<%= rid %>-d"><%= r.sugerida ? 'Sugerida automáticamente. ' : '' %><%= graves ? `${graves} aviso${graves === 1 ? '' : 's'} grave${graves === 1 ? '' : 's'}.` : '' %></span>
            </span>
          </label>
          <% }) %>
        </div>
      </fieldset>

      <div class="rv-toma__foot">
        <fieldset class="ir-seg">
          <legend class="sr-only">Estado de la toma <%= nombre %></legend>
          <% ESTADOS.forEach((e) => { %>
          <label class="ir-seg__opt ir-seg__opt--<%= e.v %>"><input type="radio" name="estado" value="<%= e.v %>"<%= t.estado === e.v ? ' checked' : '' %>><span><%= e.t %></span></label>
          <% }) %>
        </fieldset>
        <label class="sr-only" for="<%= id %>-c">Comentario de la toma</label>
        <textarea id="<%= id %>-c" class="rv-form__comment" name="comentario" rows="2" maxlength="1000" placeholder="Comentario de la toma (opcional)"><%= t.comentario %></textarea>
        <div class="rv-form__foot">
          <span class="rv-form__saved" data-ir-saved role="status" aria-live="polite"><%= saved || 'Sin revisar todavía' %></span>
          <button type="submit" class="btn btn--ghost btn--sm" data-ir-save>Guardar</button>
        </div>
        <p class="rv-result small" data-rv-result role="status" aria-live="polite" hidden></p>
      </div>
    </form>
  </article>
  <% }) %>
</div>
<% if (pages > 1) { %>
<nav class="pager" aria-label="Paginación">
  <% if (page > 1) { %><a class="btn btn--ghost btn--sm" href="/revision<%= qs({ pagina: page - 1 }) %>"><%- include('../partials/icon', { name: 'chevronLeft', size: 16 }) %>Anterior</a><% } else { %><span></span><% } %>
  <span class="small muted">Página <span class="num"><%= page %></span> de <span class="num"><%= pages %></span></span>
  <% if (page < pages) { %><a class="btn btn--ghost btn--sm" href="/revision<%= qs({ pagina: page + 1 }) %>" data-rv-next-page>Siguiente<%- include('../partials/icon', { name: 'chevronRight', size: 16 }) %></a><% } else { %><span></span><% } %>
</nav>
<% } %>
<% } %>
<script src="/js/image-review.js" defer></script>
