<%
  // Sparkline SVG (una serie, sin ejes). values: números; label: texto accesible.
  const vals = values.map(Number);
  const W = 120, H = 32, P = 3;
  const max = Math.max(1, ...vals), min = Math.min(0, ...vals);
  const x = (i) => P + (i * (W - 2 * P)) / Math.max(1, vals.length - 1);
  const y = (v) => H - P - ((v - min) / (max - min || 1)) * (H - 2 * P);
  const d = vals.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
  const area = `${d} L${x(vals.length - 1).toFixed(1)} ${H - P} L${x(0).toFixed(1)} ${H - P} Z`;
%>
<svg class="sparkline" viewBox="0 0 <%= W %> <%= H %>" width="<%= W %>" height="<%= H %>" role="img" aria-label="<%= label %>">
  <title><%= label %></title>
  <path d="<%= area %>" class="sparkline__area"/>
  <path d="<%= d %>" class="sparkline__line"/>
  <circle cx="<%= x(vals.length - 1).toFixed(1) %>" cy="<%= y(vals[vals.length - 1]).toFixed(1) %>" r="3" class="sparkline__dot"/>
</svg>
