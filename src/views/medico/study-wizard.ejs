<%
  const A = domain.ACQUISITION;
  const hasOld = Object.keys(old).length > 0;
  const v = (k, d) => (hasOld && old[k] !== undefined ? old[k] : d);
  const err = (k) => errors[k] ? `<p class="field__error">${errors[k]}</p>` : '';
  const cls = (k, extra = '') => `field${extra ? ' ' + extra : ''}${errors[k] ? ' has-error' : ''}`;
  const checklistOld = hasOld ? [].concat(old.checklist || []) : [];
  const tomaSel = String(v('toma', tomaSugerida));
  const steps = ['Paciente', 'Condiciones', 'Imágenes', 'Análisis'];
%>
<%- include('../partials/page-header', { heading: 'Nuevo estudio termográfico', lead: 'Seguí el protocolo de captura paso a paso. Al finalizar se ejecuta el análisis.', back: selected ? { href: `/medico/pacientes/${selected.id}`, label: selected.codigo } : { href: '/medico', label: 'Tablero' } }) %>

<form method="post" action="/medico/estudios" enctype="multipart/form-data" class="wizard" novalidate data-wizard>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <ol class="wizard__steps" aria-label="Pasos del estudio">
    <% steps.forEach((s, i) => { %>
    <li data-step-indicator="<%= i %>"<%- i === 0 ? ' aria-current="step"' : '' %>><span class="wizard__num num"><%= i + 1 %></span><span><%= s %></span></li>
    <% }) %>
  </ol>

  <!-- Paso 1 -->
  <section class="card wizard__panel" data-step="0" aria-labelledby="step1-title">
    <h2 id="step1-title">Paciente y consentimiento</h2>
    <div class="form-grid">
      <div class="<%= cls('patientId', 'field--span') %>">
        <label for="patientId">Paciente</label>
        <select id="patientId" name="patientId" required data-patient-select>
          <option value="">Elegí un paciente</option>
          <% rows.forEach(({ patient: p, estudios }) => { %>
          <option value="<%= p.id %>" data-estudios="<%= estudios %>" data-centro="<%= p.centro %>"<%= (v('patientId', selected && selected.id) === p.id) ? ' selected' : '' %><%= p.consentimientoFirmado ? '' : ' disabled' %>><%= p.codigo %>, <%= p.nombreCompleto %><%= p.consentimientoFirmado ? '' : ' (sin consentimiento)' %></option>
          <% }) %>
        </select>
        <%- err('patientId') %>
        <% if (!rows.length) { %><p class="field__hint">No tenés pacientes registrados. <a href="/medico/pacientes/nuevo">Registrar paciente</a></p><% } %>
      </div>
      <fieldset class="<%= cls('toma') %>">
        <legend>Toma</legend>
        <div class="segmented">
          <% domain.TOMAS.forEach((t) => { %>
          <label><input type="radio" name="toma" value="<%= t.value %>"<%= tomaSel === String(t.value) ? ' checked' : '' %> required data-toma><span><%= t.nombre %></span></label>
          <% }) %>
        </div>
        <%- err('toma') %>
      </fieldset>
      <div class="<%= cls('fechaHora') %>">
        <label for="fechaHora">Fecha y hora de la toma</label>
        <input id="fechaHora" name="fechaHora" type="datetime-local" required value="<%= hasOld && old.fechaHora ? old.fechaHora : fmt.inputDateTime(new Date()) %>">
        <%- err('fechaHora') %>
      </div>
      <div class="<%= cls('centro') %>">
        <label for="centro">Centro</label>
        <select id="centro" name="centro" required data-centro>
          <% centros.forEach((c) => { %><option<%= v('centro', defaultCentro) === c ? ' selected' : '' %>><%= c %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <span class="label">Médico/a</span>
        <p class="static"><%= user.nombreCompleto %><% if (user.matricula) { %>, <%= user.matricula %><% } %></p>
      </div>
      <label class="check check--card field--span<%= errors.consentimientoVerificado ? ' has-error' : '' %>">
        <input type="checkbox" name="consentimientoVerificado" required<%= hasOld && old.consentimientoVerificado ? ' checked' : '' %>>
        <span>Verifiqué que el paciente tiene el consentimiento informado firmado y que no presenta lesiones activas.</span>
      </label>
      <%- err('consentimientoVerificado') %>
    </div>
    <div class="wizard__nav">
      <span></span>
      <button type="button" class="btn btn--primary" data-next>Continuar</button>
    </div>
  </section>

  <!-- Paso 2 -->
  <section class="card wizard__panel" data-step="1" aria-labelledby="step2-title">
    <h2 id="step2-title">Condiciones ambientales y cámara</h2>
    <p class="muted">La humedad relativa fue el factor ambiental más influyente en la Parte 1: registrala con precisión.</p>
    <div class="env-grid">
      <div class="env-card <%= errors.tempAmbiente ? 'has-error' : '' %>" data-env="temp" data-min="<%= A.tempAmbiente.min %>" data-max="<%= A.tempAmbiente.max %>">
        <label for="tempAmbiente">Temperatura ambiente</label>
        <div class="env-card__input"><input id="tempAmbiente" name="tempAmbiente" inputmode="decimal" required value="<%= v('tempAmbiente', '') %>" placeholder="22,5"><span>°C</span></div>
        <p class="env-card__range">Válido: <%= A.tempAmbiente.min %>–<%= A.tempAmbiente.max %> °C</p>
        <span class="env-badge" data-env-badge aria-live="polite"></span>
        <%- err('tempAmbiente') %>
      </div>
      <div class="env-card env-card--key <%= errors.humedadRelativa ? 'has-error' : '' %>" data-env="hum" data-min="<%= A.humedadRelativa.min %>" data-max="<%= A.humedadRelativa.max %>">
        <label for="humedadRelativa">Humedad relativa <span class="tag tag--key">factor clave</span></label>
        <div class="env-card__input"><input id="humedadRelativa" name="humedadRelativa" inputmode="decimal" required value="<%= v('humedadRelativa', '') %>" placeholder="55"><span>%</span></div>
        <p class="env-card__range">Válido: <%= A.humedadRelativa.min %>–<%= A.humedadRelativa.max %> %</p>
        <span class="env-badge" data-env-badge aria-live="polite"></span>
        <%- err('humedadRelativa') %>
      </div>
    </div>
    <div class="form-grid form-grid--3">
      <div class="<%= cls('distanciaCm') %>">
        <label for="distanciaCm">Distancia cámara (cm)</label>
        <input id="distanciaCm" name="distanciaCm" inputmode="decimal" value="<%= v('distanciaCm', A.distanciaCm) %>">
        <%- err('distanciaCm') %>
      </div>
      <div class="<%= cls('emisividad') %>">
        <label for="emisividad">Emisividad</label>
        <input id="emisividad" name="emisividad" inputmode="decimal" value="<%= v('emisividad', String(A.emisividad).replace('.', ',')) %>">
        <%- err('emisividad') %>
      </div>
      <div class="<%= cls('tiempoEstabilizacionMin') %>">
        <label for="tiempoEstabilizacionMin">Estabilización (min)</label>
        <input id="tiempoEstabilizacionMin" name="tiempoEstabilizacionMin" type="number" min="0" max="120" value="<%= v('tiempoEstabilizacionMin', A.tiempoEstabilizacionMin) %>">
        <%- err('tiempoEstabilizacionMin') %>
      </div>
      <div class="<%= cls('rangoMin') %>">
        <label for="rangoMin">Rango mínimo (°C)</label>
        <input id="rangoMin" name="rangoMin" inputmode="decimal" value="<%= v('rangoMin', A.rango.min) %>">
      </div>
      <div class="<%= cls('rangoMax') %>">
        <label for="rangoMax">Rango máximo (°C)</label>
        <input id="rangoMax" name="rangoMax" inputmode="decimal" value="<%= v('rangoMax', A.rango.max) %>">
        <%- err('rangoMax') %>
      </div>
      <div class="field">
        <label for="paleta">Paleta</label>
        <select id="paleta" name="paleta"><% A.paletas.forEach((pal) => { %><option<%= v('paleta', 'Ironbow') === pal ? ' selected' : '' %>><%= pal %></option><% }) %></select>
      </div>
      <fieldset class="<%= cls('fondo') %>">
        <legend>Fondo</legend>
        <div class="segmented">
          <% A.fondos.forEach((fo) => { %><label><input type="radio" name="fondo" value="<%= fo %>"<%= v('fondo', A.fondos[0]) === fo ? ' checked' : '' %>><span><%= fo %></span></label><% }) %>
        </div>
      </fieldset>
    </div>
    <fieldset class="checks">
      <legend>Checklist de captura</legend>
      <% domain.CAPTURE_CHECKLIST.forEach((c) => { %>
      <label class="check"><input type="checkbox" name="checklist" value="<%= c.key %>"<%= !hasOld || checklistOld.includes(c.key) ? (hasOld ? ' checked' : '') : '' %>><span><%= c.texto %></span></label>
      <% }) %>
    </fieldset>
    <p class="muted small">Cámara: <%= A.camara %>.</p>
    <div class="wizard__nav">
      <button type="button" class="btn btn--ghost" data-prev>Volver</button>
      <button type="button" class="btn btn--primary" data-next>Continuar</button>
    </div>
  </section>

  <!-- Paso 3 -->
  <section class="card wizard__panel" data-step="2" aria-labelledby="step3-title">
    <h2 id="step3-title">Carga de imágenes</h2>
    <p class="muted">JPG, PNG, TIFF o IS2 (archivo nativo de Fluke), hasta <%= maxFileMb %> MB cada una.</p>
    <div class="dropzones">
      <% imageSlots.forEach((s) => { %>
      <div class="dropzone<%= errors[s.slot] ? ' has-error' : '' %>" data-dropzone>
        <input type="file" id="file-<%= s.slot %>" name="<%= s.slot %>" accept=".jpg,.jpeg,.png,.tif,.tiff,.is2,image/jpeg,image/png,image/tiff" required data-max-mb="<%= maxFileMb %>" class="dropzone__input">
        <label for="file-<%= s.slot %>" class="dropzone__label">
          <span class="dropzone__title"><%= s.titulo %></span>
          <span class="dropzone__desc"><%= s.descripcion %></span>
          <span class="dropzone__empty" data-dz-empty>
            <%- include('../partials/icon', { name: 'upload', size: 28 }) %>
            <span><strong>Elegí un archivo</strong> o arrastralo aquí</span>
          </span>
          <span class="dropzone__preview" data-dz-preview hidden>
            <img alt="Vista previa de <%= s.corto %>" data-dz-img hidden>
            <span class="dropzone__file" data-dz-file hidden><%- include('../partials/icon', { name: 'file', size: 28 }) %><span data-dz-ext></span></span>
            <span class="dropzone__meta"><span data-dz-name></span><span data-dz-size class="num"></span></span>
          </span>
        </label>
        <p class="field__error" data-dz-error<%= errors[s.slot] ? '' : ' hidden' %>><%= errors[s.slot] || '' %></p>
      </div>
      <% }) %>
    </div>
    <div class="form-grid">
      <fieldset class="<%= cls('valida') %>">
        <legend>Calidad de la imagen</legend>
        <div class="segmented">
          <label><input type="radio" name="valida" value="si"<%= v('valida', 'si') === 'si' ? ' checked' : '' %> data-valida><span>Válida</span></label>
          <label><input type="radio" name="valida" value="no"<%= v('valida', 'si') === 'no' ? ' checked' : '' %> data-valida><span>No válida</span></label>
        </div>
      </fieldset>
      <div class="<%= cls('motivoInvalidez') %>" data-motivo>
        <label for="motivoInvalidez">Motivo de invalidez</label>
        <input id="motivoInvalidez" name="motivoInvalidez" value="<%= v('motivoInvalidez', '') %>" placeholder="Por ejemplo: movimiento, desenfoque, fondo con reflejos">
        <%- err('motivoInvalidez') %>
      </div>
    </div>
    <div class="wizard__nav">
      <button type="button" class="btn btn--ghost" data-prev>Volver</button>
      <button type="button" class="btn btn--primary" data-next>Revisar</button>
    </div>
  </section>

  <!-- Paso 4 -->
  <section class="card wizard__panel" data-step="3" aria-labelledby="step4-title">
    <h2 id="step4-title">Revisar y analizar</h2>
    <dl class="kv summary" data-summary>
      <div><dt>Paciente</dt><dd data-sum="patientId">—</dd></div>
      <div><dt>Toma</dt><dd data-sum="toma">—</dd></div>
      <div><dt>Fecha y hora</dt><dd data-sum="fechaHora">—</dd></div>
      <div><dt>Temperatura ambiente</dt><dd data-sum="tempAmbiente">—</dd></div>
      <div><dt>Humedad relativa</dt><dd data-sum="humedadRelativa">—</dd></div>
      <div><dt>Imágenes</dt><dd data-sum="images">—</dd></div>
    </dl>
    <p class="notice notice--warn small">
      <%- include('../partials/icon', { name: 'alert', size: 18 }) %>
      <span><%= domain.DISCLAIMER %></span>
    </p>
    <div class="wizard__nav">
      <button type="button" class="btn btn--ghost" data-prev>Volver</button>
      <button type="submit" class="btn btn--primary btn--lg" data-submit><%- include('../partials/icon', { name: 'activity', size: 18 }) %>Analizar estudio</button>
    </div>
  </section>
</form>
<script src="/js/wizard.js" defer></script>
