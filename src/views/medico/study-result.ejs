<%
  const a = analysis;
  const s = study;
  const p = patient;
  const A = domain.ACQUISITION;
  const M = domain.REFERENCE_MODEL;
  const maxContrib = a ? Math.max(0.01, ...a.factores.map((f) => Math.abs(f.contribucion))) : 1;
  const fuente = { imagen: 'estimadas de las termografías', is2: 'calculadas desde los archivos IS2', simulada: 'simuladas' };
  const tend = { empeora: { label: 'Empeora', cls: 'danger', icon: 'trendUp' }, mejora: { label: 'Mejora', cls: 'ok', icon: 'trendDown' }, estable: { label: 'Estable', cls: 'muted', icon: 'minus' } };
%>
<%- include('../partials/page-header', {
  heading: `${p.codigo} · comparación de tomas`,
  lead: `${p.nombreCompleto}. Toma 1: ${fmt.date(s.fechaToma1)} · Toma 2: ${fmt.dateTime(s.fechaHora)}${s.diasEntreTomas !== null ? ` (${s.diasEntreTomas} días)` : ''} · ${s.centro}.`,
  back: { href: `/medico/pacientes/${p.id}`, label: p.codigo },
  actions: `<a class="btn btn--ghost" href="/medico/estudios/${s.id}/informe" target="_blank" rel="noopener">${include('../partials/icon', { name: 'printer', size: 18 })}Exportar informe</a>`
}) %>

<div class="notice notice--warn disclaimer" role="note">
  <%- include('../partials/icon', { name: 'alert' }) %>
  <p><strong>Resultado simulado.</strong> <%= domain.DISCLAIMER %><% if (a) { %> Temperaturas por región <%= fuente[a.fuenteRois] || 'simuladas' %>.<% } %></p>
</div>

<% if (!a) { %>
<div class="card"><div class="empty"><h2>El análisis no está disponible</h2><p>Volvé a cargar el estudio.</p></div></div>
<% } else { %>
<div class="result-hero">
  <section class="card result-hero__gauge" aria-labelledby="prob-title">
    <h2 id="prob-title" class="card__title">Probabilidad de úlcera a <%= a.horizonteSemanas %> semanas</h2>
    <%- include('../partials/gauge', { value: a.probabilidad, category: a.categoria }) %>
    <p class="muted small center">Considera la asimetría de la toma 2 y su evolución desde la toma 1. Cortes: <%= domain.RISK_CUTS.moderado %> % y <%= domain.RISK_CUTS.alto %> %.</p>
  </section>

  <section class="card result-hero__thermal" aria-labelledby="thermal-title">
    <h2 id="thermal-title" class="card__title">Clasificación térmica por toma</h2>
    <div class="compare">
      <div class="compare__col">
        <span class="compare__label"><span class="toma-dot toma-dot--1"></span>Toma 1 · basal</span>
        <div class="compare__metrics">
          <div><small>Grupo</small><span class="grupo grupo--<%= a.grupoToma1 %>"><%= a.grupoToma1 || '—' %></span></div>
          <div><small>ΔT máx.</small><strong class="num"><%= a.deltaTMaxToma1 !== null ? fmt.signed(a.deltaTMaxToma1) : '—' %> °C</strong></div>
          <div><small>Simétrico</small><strong><%= a.simetricoToma1 === null ? '—' : a.simetricoToma1 ? 'Sí' : 'No' %></strong></div>
        </div>
        <span class="muted small"><%= a.deltaTMaxRoiToma1 ? domain.ROI_NAMES[a.deltaTMaxRoiToma1] : '' %></span>
      </div>
      <div class="compare__arrow" aria-hidden="true"><%- include('../partials/icon', { name: 'arrowRight', size: 20 }) %></div>
      <div class="compare__col compare__col--now">
        <span class="compare__label"><span class="toma-dot toma-dot--2"></span>Toma 2 · control</span>
        <div class="compare__metrics">
          <div><small>Grupo</small><span class="grupo grupo--<%= a.grupo %>"><%= a.grupo %></span></div>
          <div><small>ΔT máx.</small><strong class="num"><%= fmt.signed(a.deltaTMax) %> °C</strong></div>
          <div><small>Simétrico</small><strong><%= a.simetrico ? 'Sí' : 'No' %></strong></div>
        </div>
        <span class="muted small"><%= domain.ROI_NAMES[a.deltaTMaxRoi] %>, pie <%= a.deltaTMax >= 0 ? 'derecho' : 'izquierdo' %> más caliente</span>
      </div>
    </div>
    <div class="evolution-summary">
      <% if (a.roisQueEmpeoran.length) { %>
      <p><span class="trend trend--danger"><%- include('../partials/icon', { name: 'trendUp', size: 16 }) %>Asimetría en aumento</span> en <%= a.roisQueEmpeoran.map((e) => domain.ROI_NAMES[e.roi].toLowerCase()).join(', ') %> (máx. +<%= fmt.num(a.maxEmpeoramiento, 1) %> °C).</p>
      <% } else { %>
      <p><span class="trend trend--ok"><%- include('../partials/icon', { name: 'check', size: 16 }) %>Sin aumento relevante de la asimetría</span> entre tomas (cambio &lt; <%= fmt.num(domain.CAMBIO_SIGNIFICATIVO, 1) %> °C).</p>
      <% } %>
    </div>
    <p class="threshold">
      Umbral de asimetría: <strong class="num"><%= fmt.num(a.umbral, 1) %> °C</strong>
      (<%= (domain.THRESHOLD_OPTIONS.find((o) => o.value === a.umbral) || { fuente: 'configuración del sistema' }).fuente %>; referencia bibliográfica <%= fmt.num(domain.DELTA_T_REFERENCIA, 1) %> °C).
      Grupo P = alguna región con |ΔT| ≥ umbral. Todos los participantes son diabéticos: «C» indica ausencia de asimetría, no un sujeto sano.
    </p>
  </section>
</div>

<section class="card" aria-labelledby="maps-title">
  <div class="card__head">
    <h2 id="maps-title" class="card__title">Mapa plantar por región</h2>
    <div class="tabs tabs--pill" role="tablist" data-tabs="maps">
      <button type="button" role="tab" class="tabs__item is-active" aria-selected="true" data-tab="ambas">Ambas tomas</button>
      <button type="button" role="tab" class="tabs__item" aria-selected="false" data-tab="t1">Toma 1</button>
      <button type="button" role="tab" class="tabs__item" aria-selected="false" data-tab="t2">Toma 2</button>
    </div>
  </div>
  <div class="maps-compare" data-tab-panel="maps" data-show="ambas">
    <figure class="maps-compare__item" data-only="t1">
      <figcaption><span class="toma-dot toma-dot--1"></span>Toma 1 · <%= fmt.date(s.fechaToma1) %></figcaption>
      <%- include('../partials/plantar-map', { rois: a.roisToma1, umbral: a.umbral, mapId: 'res1' }) %>
    </figure>
    <figure class="maps-compare__item" data-only="t2">
      <figcaption><span class="toma-dot toma-dot--2"></span>Toma 2 · <%= fmt.date(s.fechaHora) %></figcaption>
      <%- include('../partials/plantar-map', { rois: a.rois, umbral: a.umbral, mapId: 'res2' }) %>
    </figure>
  </div>
</section>

<div class="grid grid--map">
  <section class="card card--flush" aria-labelledby="evo-title">
    <div class="card__head card__head--pad">
      <h2 id="evo-title" class="card__title">Evolución de la asimetría</h2>
      <span class="muted small">ΔT = derecho − izquierdo (°C)</span>
    </div>
    <div class="table-wrap">
      <table class="table table--num">
        <thead><tr><th scope="col">Región</th><th scope="col">ΔT toma 1</th><th scope="col">ΔT toma 2</th><th scope="col">Cambio |ΔT|</th><th scope="col">Tendencia</th></tr></thead>
        <tbody>
          <% a.evolucion.forEach((e) => { const t = tend[e.tendencia]; %>
          <tr class="<%= e.roi === 'general' ? 'row-total' : '' %><%= e.tendencia === 'empeora' && e.roi !== 'general' ? ' row-hot' : '' %>">
            <th scope="row"><%= domain.ROI_NAMES[e.roi] %></th>
            <td><span class="delta<%= Math.abs(e.dt1) >= a.umbral && e.roi !== 'general' ? ' delta--hot' : '' %>"><%= fmt.signed(e.dt1, 2) %></span></td>
            <td><span class="delta<%= Math.abs(e.dt2) >= a.umbral && e.roi !== 'general' ? ' delta--hot' : '' %>"><%= fmt.signed(e.dt2, 2) %></span></td>
            <td><%= fmt.signed(e.cambio, 2) %></td>
            <td><span class="trend trend--<%= t.cls %>"><%- include('../partials/icon', { name: t.icon, size: 14 }) %><%= t.label %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="table-note">Cambio |ΔT| = |ΔT toma 2| − |ΔT toma 1|. Se marca como empeoramiento a partir de +<%= fmt.num(domain.CAMBIO_SIGNIFICATIVO, 1) %> °C.</p>
  </section>

  <section class="card card--flush" aria-labelledby="roi-title">
    <div class="card__head card__head--pad">
      <h2 id="roi-title" class="card__title">Temperaturas por región</h2>
      <div class="tabs tabs--pill" role="tablist" data-tabs="rois">
        <button type="button" role="tab" class="tabs__item" aria-selected="false" data-tab="t1">Toma 1</button>
        <button type="button" role="tab" class="tabs__item is-active" aria-selected="true" data-tab="t2">Toma 2</button>
      </div>
    </div>
    <div data-tab-panel="rois" data-show="t2">
      <% [[1, a.roisToma1], [2, a.rois]].forEach(([toma, list]) => { %>
      <div class="table-wrap" data-only="t<%= toma %>">
        <table class="table table--num">
          <caption class="sr-only">Temperaturas medias por región, toma <%= toma %></caption>
          <thead><tr><th scope="col">Región</th><th scope="col">Media der.</th><th scope="col">Media izq.</th><th scope="col">ΔT</th><th scope="col">Máx. der./izq.</th></tr></thead>
          <tbody>
            <% list.forEach((r) => { const hot = r.roi !== 'general' && Math.abs(r.deltaT) >= a.umbral; const lit = r.roi !== 'general' && Math.abs(r.deltaT) >= domain.DELTA_T_REFERENCIA; %>
            <tr class="<%= r.roi === 'general' ? 'row-total' : '' %><%= hot ? ' row-hot' : '' %>">
              <th scope="row"><%= domain.ROI_NAMES[r.roi] %></th>
              <td><%= fmt.num(r.avgDer, 2) %></td>
              <td><%= fmt.num(r.avgIzq, 2) %></td>
              <td><span class="delta<%= hot ? ' delta--hot' : '' %>"><%= fmt.signed(r.deltaT, 2) %></span><% if (lit) { %><span class="tag tag--lit" title="Supera la referencia bibliográfica (no diagnóstico)">≥ <%= fmt.num(domain.DELTA_T_REFERENCIA, 1) %></span><% } %></td>
              <td class="muted"><%= fmt.num(r.maxDer, 1) %> / <%= fmt.num(r.maxIzq, 1) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% }) %>
    </div>
    <p class="table-note">Filas resaltadas: |ΔT| ≥ <%= fmt.num(a.umbral, 1) %> °C. Temperaturas <%= fuente[a.fuenteRois] || 'simuladas' %><%= a.fuenteRois !== 'simulada' ? ' (conversión aproximada, sin calibración radiométrica)' : '' %>.</p>
  </section>
</div>

<div class="grid grid--2">
  <section class="card" aria-labelledby="fact-title">
    <h2 id="fact-title" class="card__title">Factores que más contribuyen</h2>
    <ul class="factors">
      <% a.factores.forEach((f) => { %>
      <li>
        <span class="factors__name"><%= f.nombre %></span>
        <span class="factors__value"><%= f.valor %></span>
        <span class="factors__bar" aria-hidden="true"><span style="width: <%= Math.round((Math.abs(f.contribucion) / maxContrib) * 100) %>%"></span></span>
        <span class="factors__num num">+<%= fmt.num(f.contribucion, 2) %></span>
      </li>
      <% }) %>
    </ul>
    <p class="muted small">Contribución al log-odds del predictor simulado. Sirve para validar la interfaz, no para interpretación clínica.</p>
  </section>

  <section class="card model-card" aria-labelledby="model-title">
    <h2 id="model-title" class="card__title">Ficha del modelo</h2>
    <dl class="kv kv--compact">
      <div><dt>Predictor activo</dt><dd><code><%= a.predictorVersion %></code> <%= predictorInfo.nombre %></dd></div>
      <div><dt>Modelo de referencia</dt><dd><%= M.nombre %> (<%= M.hiperparametros %>), validación <%= M.validacion %>, n = <%= M.n %></dd></div>
    </dl>
    <div class="model-metrics">
      <div><span class="num"><%= fmt.num(M.auc, 3) %></span><small>AUC</small></div>
      <div><span class="num"><%= fmt.num(M.sensibilidad, 1) %> %</span><small>Sensibilidad</small></div>
      <div><span class="num"><%= fmt.num(M.especificidad, 1) %> %</span><small>Especificidad</small></div>
      <div><span class="num"><%= fmt.num(M.vpp, 1) %> %</span><small>VPP</small></div>
      <div><span class="num"><%= fmt.num(M.vpn, 1) %> %</span><small>VPN</small></div>
    </div>
    <p class="muted small"><%= M.fuente %>. Métricas mostradas como referencia; el resultado de esta pantalla es simulado.</p>
  </section>
</div>
<% } %>

<div class="grid grid--2">
  <section class="card" aria-labelledby="img-title">
    <h2 id="img-title" class="card__title">Termografías</h2>
    <div class="image-pair">
      <% imageSlots.forEach((sl) => { const img = s.image(sl.slot); %>
      <figure class="image-tile">
        <% if (img && canPreview(img)) { %>
        <button type="button" class="image-tile__btn" data-lightbox="<%= imageUrl(s, sl.slot) %>" data-caption="<%= sl.titulo %>">
          <img src="<%= imageUrl(s, sl.slot) %>" alt="<%= sl.titulo %> de <%= p.codigo %>" loading="lazy" width="480" height="360">
          <span class="image-tile__badge image-tile__badge--t<%= sl.toma %>"><%= sl.etiqueta %></span>
        </button>
        <% } else if (img) { %>
        <a class="image-tile__file" href="<%= imageUrl(s, sl.slot) %>"><%- include('../partials/icon', { name: 'file', size: 28 }) %><span><%= img.originalName %></span><small>Descargar (<%= fmt.bytes(img.size) %>)</small></a>
        <% } else { %>
        <div class="image-tile__file"><span>Sin imagen</span></div>
        <% } %>
        <figcaption><%= sl.toma === 1 ? fmt.date(s.fechaToma1) : fmt.date(s.fechaHora) %><%= sl.toma === 1 && s.toma1OrigenStudyId ? ' · reutilizada de un estudio anterior' : '' %></figcaption>
      </figure>
      <% }) %>
    </div>
  </section>

  <section class="card" aria-labelledby="acq-title">
    <h2 id="acq-title" class="card__title">Condiciones de adquisición</h2>
    <div class="cond-grid">
      <div>
        <h3 class="card__subtitle">Toma 2 · control</h3>
        <div class="env-summary">
          <span class="env-chip <%= s.tempAmbienteOk ? 'is-ok' : 'is-warn' %>"><%- include('../partials/icon', { name: 'thermo', size: 16 }) %><strong class="num"><%= fmt.num(s.tempAmbiente, 1) %> °C</strong></span>
          <span class="env-chip env-chip--key <%= s.humedadOk ? 'is-ok' : 'is-warn' %>"><%- include('../partials/icon', { name: 'droplet', size: 16 }) %>HR <strong class="num"><%= fmt.num(s.humedadRelativa, 0) %> %</strong></span>
        </div>
      </div>
      <div>
        <h3 class="card__subtitle">Toma 1 · basal</h3>
        <% if (s.tempAmbienteToma1 !== null || s.humedadRelativaToma1 !== null) { %>
        <div class="env-summary">
          <span class="env-chip <%= s.condicionesToma1Ok ? 'is-ok' : 'is-warn' %>"><%- include('../partials/icon', { name: 'thermo', size: 16 }) %><strong class="num"><%= fmt.num(s.tempAmbienteToma1, 1) %> °C</strong></span>
          <span class="env-chip env-chip--key <%= s.condicionesToma1Ok ? 'is-ok' : 'is-warn' %>"><%- include('../partials/icon', { name: 'droplet', size: 16 }) %>HR <strong class="num"><%= fmt.num(s.humedadRelativaToma1, 0) %> %</strong></span>
        </div>
        <% } else { %><p class="muted small">Sin registro.</p><% } %>
      </div>
    </div>
    <div class="env-summary">
      <span class="env-chip <%= s.valida ? 'is-ok' : 'is-warn' %>"><%- include('../partials/icon', { name: s.valida ? 'check' : 'alert', size: 16 }) %><%= s.valida ? 'Imágenes válidas' : 'Imágenes no válidas' %></span>
      <span class="env-chip <%= s.intervaloOk ? 'is-ok' : 'is-warn' %>"><%- include('../partials/icon', { name: 'calendar', size: 16 }) %><%= s.diasEntreTomas !== null ? `${s.diasEntreTomas} días entre tomas` : 'Intervalo sin dato' %></span>
    </div>
    <% if (!s.condicionesOk) { %><p class="text-warn small">Condiciones de la toma 2 fuera del rango del protocolo (<%= A.tempAmbiente.min %>–<%= A.tempAmbiente.max %> °C, <%= A.humedadRelativa.min %>–<%= A.humedadRelativa.max %> %). Interpretá el resultado con cautela.</p><% } %>
    <% if (!s.valida && s.motivoInvalidez) { %><p class="text-warn small">Motivo: <%= s.motivoInvalidez %></p><% } %>
    <dl class="kv kv--compact kv--2col">
      <div><dt>Distancia</dt><dd class="num"><%= s.distanciaCm %> cm</dd></div>
      <div><dt>Emisividad</dt><dd class="num"><%= fmt.num(s.emisividad, 2) %></dd></div>
      <div><dt>Rango</dt><dd class="num"><%= s.rangoMin %>–<%= s.rangoMax %> °C</dd></div>
      <div><dt>Paleta</dt><dd><%= s.paleta %></dd></div>
      <div><dt>Estabilización</dt><dd class="num"><%= s.tiempoEstabilizacionMin %> min</dd></div>
      <div><dt>Fondo</dt><dd><%= s.fondo %></dd></div>
    </dl>
  </section>
</div>

<div class="grid grid--2">
  <section class="card" id="notas" aria-labelledby="notes-title">
    <h2 id="notes-title" class="card__title">Notas del médico</h2>
    <form method="post" action="/medico/estudios/<%= s.id %>/notas" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="notasMedico" class="sr-only">Notas</label>
      <textarea id="notasMedico" name="notasMedico" rows="4" placeholder="Hallazgos de la inspección, indicaciones, derivaciones"><%= s.notasMedico %></textarea>
      <div class="form__actions"><button type="submit" class="btn btn--ghost btn--sm">Guardar notas</button></div>
    </form>
  </section>

  <section class="card" aria-labelledby="pub-title">
    <h2 id="pub-title" class="card__title">Visibilidad para el paciente</h2>
    <% if (s.publicado) { %>
    <p><span class="badge badge--ok"><span class="dot" aria-hidden="true"></span>Visible</span> desde el <%= fmt.dateTime(s.publicadoAt) %>. El paciente ve un resumen en lenguaje simple, sin métricas del modelo.</p>
    <% } else { %>
    <p><span class="badge badge--outline">No publicado</span> El paciente ve que se realizó el estudio, pero no el resultado.</p>
    <% } %>
    <form method="post" action="/medico/estudios/<%= s.id %>/publicacion"<%- s.publicado ? ' data-confirm="¿Ocultar el resultado al paciente?"' : '' %>>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (!s.publicado) { %><input type="hidden" name="publicado" value="on"><% } %>
      <button type="submit" class="btn <%= s.publicado ? 'btn--ghost' : 'btn--primary' %> btn--sm"><%= s.publicado ? 'Ocultar al paciente' : 'Hacer visible al paciente' %></button>
    </form>
  </section>
</div>

<div class="grid grid--2">
  <section class="card" id="control" aria-labelledby="ctl-title">
    <h2 id="ctl-title" class="card__title">Próximo control</h2>
    <% if (proximo) { %>
    <p>Programado para el <strong><%= fmt.dateLong(proximo.fecha) %></strong> (<%= fmt.relativeDays(proximo.fecha) %>). <span class="muted"><%= proximo.motivo %></span></p>
    <% } else { %>
    <p class="muted">Sin control programado.</p>
    <% } %>
    <form method="post" action="/medico/estudios/<%= s.id %>/control" class="form form--inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field<%= errors.fecha ? ' has-error' : '' %>">
        <label for="fecha-control">Fecha</label>
        <input id="fecha-control" name="fecha" type="date" required value="<%= defaultControl %>">
      </div>
      <div class="field field--grow">
        <label for="motivo-control">Motivo</label>
        <input id="motivo-control" name="motivo" value="Control clínico a 6 semanas">
      </div>
      <button type="submit" class="btn btn--primary btn--sm"><%= proximo ? 'Reprogramar' : 'Programar control' %></button>
    </form>
    <p class="hint">Sugerido: 6 semanas después de la toma 2. Un control nuevo reemplaza al pendiente.</p>
  </section>

  <section class="card" id="desenlace" aria-labelledby="out-title">
    <h2 id="out-title" class="card__title">Desenlace real</h2>
    <p class="muted small">Se registra por paciente al finalizar el seguimiento y alimenta la validación del modelo.</p>
    <%- include('../partials/outcome-form', { patient: p, volver: `/medico/estudios/${s.id}#desenlace` }) %>
  </section>
</div>
