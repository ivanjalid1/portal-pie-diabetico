# ---------------------------------------------------------------
# TermoPie · variables de entorno (copiar a .env y completar)
# ---------------------------------------------------------------

# Entorno: development | production | test
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Persistencia: memory (por defecto, datos demo en memoria) | supabase
DATA_DRIVER=memory

# Estrategia de predicción: mock (por defecto) | logreg | cnn (pendientes)
PREDICTOR=mock

# Umbral de asimetría |ΔT| en °C para el grupo térmico P/C.
# 1.0 = solicitud del PI / planilla del equipo (por defecto); 2.2 = literatura.
ASYMMETRY_THRESHOLD=1.0

# Sesión (cookie firmada). En producción usar un valor largo y aleatorio.
SESSION_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
SESSION_MAX_AGE_HOURS=8
COOKIE_SECURE=false

# Seguridad
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
BCRYPT_ROUNDS=10

# Tamaño máximo por archivo (MB). Ojo: Vercel limita el cuerpo a ~4,5 MB.
MAX_UPLOAD_MB=4

# Mostrar el recuadro «Cuentas demo» en el login
SHOW_DEMO_ACCOUNTS=true

# --- Supabase (sólo si DATA_DRIVER=supabase) ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
# ¡Sólo en el servidor! Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=estudios
SUPABASE_SIGNED_URL_TTL=120
