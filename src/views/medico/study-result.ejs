<%
  const a = analysis;
  const s = study;
  const p = patient;
  const P = paramsOf(a);
  const C = s.condiciones(P.protocolo);
  const M = domain.REFERENCE_MODEL;
  const PW = a && a.puntual;
  const MOD = PW && PW.modelo;
  const t2 = PW ? PW.tieneToma2 : Boolean(s.image('toma2'));
  const maxContrib = a && a.factores.length ? Math.max(0.01, ...a.factores.map((f) => Math.abs(f.contribucion))) : 1;
  const regiones = a ? (a.tieneToma2 && a.roisToma1.length ? [[1, a.roisToma1], [2, a.rois]] : [[PW ? PW.tomaActual : 2, a.rois]]) : [];
  const tomaLabel = (k) => (k === 1 ? 'Toma 1 · basal' : 'Toma 2 · control');
  const fechaToma = (k) => (k === 1 ? s.fechaToma1 : s.fechaHora);
  const grupoDe = (k) => (regiones.length > 1 && k === 1 ? a.grupoToma1 : a.grupo);
%>
<%- include('../partials/page-header', {
  heading: `${p.codigo} · análisis punto a punto`,
  lead: `${p.nombreCompleto}. Toma 1: ${fmt.date(s.fechaToma1)}` + (t2 ? ` · Toma 2: ${fmt.date(s.fechaHora)}${s.diasEntreTomas !== null ? ` (${s.diasEntreTomas} días)` : ''}` : ' · Sin toma 2') + (s.centro ? ` · ${s.centro}.` : '.'),
  back: { href: `/medico/pacientes/${p.id}`, label: p.codigo },
  actions: `<a class="btn btn--ghost" href="/medico/estudios/${s.id}/informe" target="_blank" rel="noopener">${include('../partials/icon', { name: 'printer', size: 18 })}Exportar informe</a>`
}) %>

<div class="notice notice--warn disclaimer" role="note">
  <%- include('../partials/icon', { name: 'alert' }) %>
  <% if (PW) { %>
  <p><strong>Herramienta exploratoria, no diagnóstica.</strong> Temperaturas aproximadas (conversión lineal de las cuentas de la cámara, sin calibración radiométrica). El modelo de probabilidad es preliminar y no está validado clínicamente.</p>
  <% } else { %>
  <p><strong>Resultado simulado.</strong> No se pudo hacer el análisis punto a punto porque las imágenes no son archivos radiométricos (.IS2).</p>
  <% } %>
</div>

<% if (!a) { %>
<div class="card"><div class="empty"><h2>El análisis no está disponible</h2><p>Volvé a cargar el estudio.</p></div></div>
<% } else { %>
<div class="result-hero">
  <section class="card result-hero__gauge" aria-labelledby="prob-title">
    <div class="card__head"><h2 id="prob-title" class="card__title">Modelo preliminar</h2><span class="badge badge--outline">No validado</span></div>
    <% if (MOD) { %>
    <div class="prelim">
      <span class="prelim__value num"><%= fmt.num(a.probabilidad, 1) %><small>%</small></span>
      <span class="prelim__bar" role="img" aria-label="Probabilidad del modelo preliminar: <%= fmt.num(a.probabilidad, 0) %> por ciento"><span style="width: <%= Math.max(2, a.probabilidad) %>%"></span></span>
      <span class="prelim__ticks num"><span>0</span><span>50</span><span>100 %</span></span>
    </div>
    <p class="small center">Probabilidad estimada de <strong>HbA1c &gt; 7 %</strong> (desenlace sustituto, como en la Parte 1) a partir de la toma <%= MOD.tomaUsada %>.</p>
    <div class="model-strip">
      <span>AUC <%= MOD.metodo === 'Leave-One-Out' ? 'LOO' : 'CV' %> <strong class="num"><%= fmt.num(MOD.auc, 2) %></strong></span>
      <% if (MOD.aucIC95) { %><span>IC 95 % <span class="num"><%= fmt.num(MOD.aucIC95[0], 2) %>–<%= fmt.num(MOD.aucIC95[1], 2) %></span></span><% } %>
      <span>n <strong class="num"><%= MOD.n %></strong></span>
    </div>
    <% if (PW.categoriaPor === 'hallazgo_termico') { %>
    <div class="prelim__cat"><span class="small">Categoría por hallazgo térmico</span> <%- include('../partials/risk-badge', { analysis: a }) %></div>
    <p class="muted small center">El modelo todavía no discrimina (AUC &lt; 0,7): la categoría resume la asimetría punto a punto, no esta probabilidad.</p>
    <% } %>
    <% } else { %>
    <%- include('../partials/gauge', { value: a.probabilidad, category: a.categoria, cortes: { moderado: P.corteModerado, alto: P.corteAlto } }) %>
    <p class="muted small center">Probabilidad simulada (sin análisis punto a punto).</p>
    <% } %>
  </section>

  <section class="card result-hero__thermal" aria-labelledby="sum-title">
    <div class="card__head"><h2 id="sum-title" class="card__title">Resumen punto a punto</h2><% if (PW) { %><span class="muted small nowrap">|ΔT| &gt; <span class="num"><%= fmt.num(PW.umbralPixel, 1) %> °C</span></span><% } %></div>
    <% if (PW) { %>
    <div class="pw-summary">
      <% [1, 2].forEach((k) => { const t = a.puntualToma(k); %>
      <div class="pw-summary__item<%= t && t.toma === PW.tomaActual ? ' is-now' : '' %><%= t ? '' : ' is-empty' %>">
        <span class="pw-summary__label"><span class="toma-dot toma-dot--<%= k %>"></span><%= tomaLabel(k) %></span>
        <% if (t && t.metricas) { %>
        <strong class="pw-summary__big num"><%= fmt.num(t.metricas.areaCalientePct, 1) %> %</strong>
        <small>del área plantar con diferencia sobre el umbral</small>
        <span class="badge badge--<%= t.conAsimetria ? 'danger' : 'ok' %>"><%= t.conAsimetria ? 'Con asimetría' : 'Sin asimetría' %></span>
        <small class="muted">Máx. <span class="num"><%= fmt.num(t.metricas.maxAbs, 1) %> °C</span> en <%= pw.ZONA_NOMBRES[t.metricas.hotspot.zona] %></small>
        <% if (t.zonasNoAnalizadas.length) { %><small class="text-warn">No analizado: <%= pw.zonasTexto(t).noAnalizado %></small><% } %>
        <% } else if (t) { %>
        <small class="muted">Sin puntos comparables.</small>
        <% } else { %>
        <strong class="pw-summary__big pw-summary__big--muted">Sin toma 2</strong>
        <small class="muted">Se analizó sólo la termografía basal.</small>
        <% } %>
      </div>
      <% }) %>
    </div>
    <% if (PW.cambio && PW.cambio.izq && PW.cambio.der) { %>
    <p class="small pw-summary__change"><%- include('../partials/icon', { name: 'trendUp', size: 16 }) %><span>Toma 1 → 2: cambio mediano izq. <span class="num"><%= fmt.signed(PW.cambio.izq.mediana, 1) %> °C</span>, der. <span class="num"><%= fmt.signed(PW.cambio.der.mediana, 1) %> °C</span>; cambio local en <span class="num"><%= fmt.num(PW.cambio.izq.areaCambioLocalPct, 0) %> %</span> y <span class="num"><%= fmt.num(PW.cambio.der.areaCambioLocalPct, 0) %> %</span> del pie.</span></p>
    <% } %>
    <% } else { %>
    <p class="muted">No disponible para este estudio.</p>
    <% } %>
  </section>
</div>

<% if (PW) { %><%- include('../partials/pointwise-study', { analysis: a, study: s }) %><% } %>

<div class="grid grid--2">
  <section class="card" aria-labelledby="fact-title">
    <h2 id="fact-title" class="card__title">Variables del modelo preliminar</h2>
    <% if (a.factores.length) { %>
    <ul class="factors">
      <% a.factores.forEach((f) => { %>
      <li>
        <span class="factors__name"><%= f.nombre %></span>
        <span class="factors__value"><%= f.valor %></span>
        <span class="factors__bar<%= f.contribucion < 0 ? ' factors__bar--neg' : '' %>" aria-hidden="true"><span style="width: <%= Math.round((Math.abs(f.contribucion) / maxContrib) * 100) %>%"></span></span>
        <span class="factors__num num"><%= fmt.signed(f.contribucion, 2) %></span>
      </li>
      <% }) %>
    </ul>
    <p class="muted small">Contribución al log-odds (coeficiente × valor estandarizado). Sirve para entender el modelo, no para interpretación clínica.</p>
    <% } else { %><p class="muted">Sin variables.</p><% } %>
  </section>

  <section class="card model-card" aria-labelledby="model-title">
    <h2 id="model-title" class="card__title">Ficha del modelo</h2>
    <dl class="kv kv--compact">
      <div><dt>Análisis</dt><dd><code><%= a.predictorVersion %></code> <%= predictorInfo.nombre %></dd></div>
      <% if (MOD) { %>
      <div><dt>Modelo preliminar</dt><dd>Regresión logística L2 sobre <%= predictorInfo.modelo ? predictorInfo.modelo.features.join(', ').toLowerCase() : 'features punto a punto' %></dd></div>
      <div><dt>Validación</dt><dd><%= MOD.metodo %>: AUC <span class="num"><%= fmt.num(MOD.auc, 3) %></span><% if (MOD.aucKFold !== null) { %>; 5 pliegues ×20: <span class="num"><%= fmt.num(MOD.aucKFold, 3) %></span><% } %> (n = <%= MOD.n %>)</dd></div>
      <div><dt>Desenlace</dt><dd><%= MOD.desenlace %></dd></div>
      <% } %>
      <div><dt>Referencia (Parte 1)</dt><dd><%= M.nombre %> por regiones (<%= M.hiperparametros %>), <%= M.validacion %>, n = <%= M.n %>, AUC <span class="num"><%= fmt.num(M.auc, 3) %></span></dd></div>
    </dl>
    <p class="muted small">Un AUC cercano o menor a 0,5 indica que, con estos datos, la asimetría punto a punto no predice el desenlace sustituto. Se muestra por transparencia, no para decidir.</p>
  </section>
</div>

<details class="disclosure disclosure--card regions-ref">
  <summary>Referencia: análisis por regiones (tesis parte 1)</summary>
  <p class="muted small">Seis regiones por pie más la general, calculadas sobre la misma grilla registrada. ΔT por región = derecho − izquierdo (convención de la Parte 1). Umbral por región <span class="num"><%= fmt.num(a.umbral, 1) %> °C</span>.</p>
  <div class="maps-compare">
    <% regiones.forEach(([k, list], i) => { %>
    <figure class="maps-compare__item">
      <figcaption><span class="toma-dot toma-dot--<%= k %>"></span><strong><%= tomaLabel(k) %></strong> <span class="muted"><%= fmt.date(fechaToma(k)) %></span><% if (grupoDe(k)) { %> <%- include('../partials/grupo', { value: grupoDe(k), small: true }) %><% } %></figcaption>
      <%- include('../partials/plantar-map', { rois: list, umbral: a.umbral, mapId: `res${i}` }) %>
    </figure>
    <% }) %>
  </div>
  <div class="roi-pair">
    <% regiones.forEach(([toma, list]) => { %>
    <div class="roi-pair__item">
      <h3 class="roi-pair__title"><span class="toma-dot toma-dot--<%= toma %>"></span><%= tomaLabel(toma) %></h3>
      <div class="table-wrap">
      <table class="table table--num">
        <caption class="sr-only">Temperaturas medias por región, toma <%= toma %></caption>
        <thead><tr><th scope="col">Región</th><th scope="col">Media der.</th><th scope="col">Media izq.</th><th scope="col">ΔT</th><th scope="col">Máx. der./izq.</th></tr></thead>
        <tbody>
          <% list.forEach((r) => { const hot = r.roi !== 'general' && Math.abs(r.deltaT) >= a.umbral; %>
          <tr class="<%= r.roi === 'general' ? 'row-total' : '' %><%= hot ? ' row-hot' : '' %>">
            <th scope="row"><%= domain.ROI_NAMES[r.roi] %></th>
            <td><%= fmt.num(r.avgDer, 2) %></td>
            <td><%= fmt.num(r.avgIzq, 2) %></td>
            <td><span class="delta<%= hot ? ' delta--hot' : '' %>"><%= fmt.signed(r.deltaT, 2) %></span></td>
            <td class="muted"><%= fmt.num(r.maxDer, 1) %> / <%= fmt.num(r.maxIzq, 1) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </div>
    <% }) %>
  </div>
</details>
<% } %>

<div class="grid grid--2">
  <section class="card" aria-labelledby="img-title">
    <h2 id="img-title" class="card__title">Termografías</h2>
    <div class="image-pair">
      <% imageSlots.forEach((sl) => { if (sl.toma === 2 && !s.image('toma2')) { %>
      <figure class="image-tile"><div class="image-tile__file image-tile__file--empty"><%- include('../partials/icon', { name: 'calendar', size: 24 }) %><span>Sin toma 2</span><small>No hay termografía de control para este estudio.</small></div><figcaption><%= slotTitulo(sl) %></figcaption></figure>
      <% } else { %>
      <%- include('../partials/thermo-tile', { study: s, sl, sub: (sl.toma === 1 ? fmt.date(s.fechaToma1) : fmt.date(s.fechaHora)) + (sl.toma === 1 && s.toma1OrigenStudyId ? ' · reutilizada' : '') }) %>
      <% } }) %>
    </div>
  </section>

  <section class="card" aria-labelledby="acq-title">
    <h2 id="acq-title" class="card__title">Condiciones de adquisición</h2>
    <% const env = (t, h, okT, okH) => (t === null && h === null) ? '<p class="muted small">Sin registro.</p>' : `<div class="env-summary"><span class="env-chip ${okT ? 'is-ok' : 'is-warn'}">${include('../partials/icon', { name: 'thermo', size: 16 })}<strong class="num">${fmt.num(t, 1)} °C</strong></span><span class="env-chip env-chip--key ${okH ? 'is-ok' : 'is-warn'}">${include('../partials/icon', { name: 'droplet', size: 16 })}HR <strong class="num">${fmt.num(h, 0)} %</strong></span></div>`; %>
    <div class="cond-grid">
      <div>
        <h3 class="card__subtitle">Toma 1 · basal</h3>
        <%- env(s.tempAmbienteToma1, s.humedadRelativaToma1, C.toma1Ok, C.toma1Ok) %>
      </div>
      <div>
        <h3 class="card__subtitle"><%= t2 ? 'Toma 2 · control' : 'Toma 2' %></h3>
        <% if (t2) { %><%- env(s.tempAmbiente, s.humedadRelativa, C.tempOk, C.humOk) %><% } else { %><p class="muted small">Sin toma 2.</p><% } %>
      </div>
    </div>
    <div class="env-summary">
      <span class="env-chip <%= s.valida ? 'is-ok' : 'is-warn' %>"><%- include('../partials/icon', { name: s.valida ? 'check' : 'alert', size: 16 }) %><%= s.valida ? 'Imágenes válidas' : 'Imágenes no válidas' %></span>
      <% if (t2) { %><span class="env-chip <%= s.intervaloOk ? 'is-ok' : 'is-warn' %>"><%- include('../partials/icon', { name: 'calendar', size: 16 }) %><%= s.diasEntreTomas !== null ? `${s.diasEntreTomas} días entre tomas` : 'Intervalo sin dato' %></span><% } %>
    </div>
    <% if (t2 && s.tempAmbiente !== null && !C.ok) { %><p class="text-warn small">Condiciones de la toma 2 fuera del rango del protocolo (<%= fmt.num(C.temp.min, 1) %>–<%= fmt.num(C.temp.max, 1) %> °C, <%= C.hum.min %>–<%= C.hum.max %> %). Interpretá el resultado con cautela.</p><% } %>
    <% if (!s.valida && s.motivoInvalidez) { %><p class="text-warn small">Motivo: <%= s.motivoInvalidez %></p><% } %>
    <dl class="kv kv--compact kv--2col">
      <div><dt>Distancia</dt><dd class="num"><%= s.distanciaCm %> cm</dd></div>
      <div><dt>Emisividad</dt><dd class="num"><%= fmt.num(s.emisividad, 2) %></dd></div>
      <div><dt>Rango</dt><dd class="num"><%= s.rangoMin %>–<%= s.rangoMax %> °C</dd></div>
      <div><dt>Paleta</dt><dd><%= s.paleta %></dd></div>
      <div><dt>Estabilización</dt><dd class="num"><%= s.tiempoEstabilizacionMin %> min</dd></div>
      <div><dt>Fondo</dt><dd><%= s.fondo %></dd></div>
    </dl>
  </section>
</div>

<div class="grid grid--2">
  <section class="card" id="notas" aria-labelledby="notes-title">
    <h2 id="notes-title" class="card__title">Notas del médico</h2>
    <form method="post" action="/medico/estudios/<%= s.id %>/notas" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="notasMedico" class="sr-only">Notas</label>
      <textarea id="notasMedico" name="notasMedico" rows="4" placeholder="Hallazgos de la inspección, indicaciones, derivaciones"><%= s.notasMedico %></textarea>
      <div class="form__actions"><button type="submit" class="btn btn--ghost btn--sm">Guardar notas</button></div>
    </form>
  </section>

  <section class="card" id="control" aria-labelledby="ctl-title">
    <h2 id="ctl-title" class="card__title">Próximo control</h2>
    <% if (proximo) { %>
    <p>Programado para el <strong><%= fmt.dateLong(proximo.fecha) %></strong> (<%= fmt.relativeDays(proximo.fecha) %>). <span class="muted"><%= proximo.motivo %></span></p>
    <% } else { %>
    <p class="muted">Sin control programado.</p>
    <% } %>
    <form method="post" action="/medico/estudios/<%= s.id %>/control" class="form form--inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field<%= errors.fecha ? ' has-error' : '' %>">
        <label for="fecha-control">Fecha</label>
        <input id="fecha-control" name="fecha" type="date" required value="<%= defaultControl %>">
      </div>
      <div class="field field--grow">
        <label for="motivo-control">Motivo</label>
        <input id="motivo-control" name="motivo" value="Control clínico posterior al estudio">
      </div>
      <button type="submit" class="btn btn--primary btn--sm"><%= proximo ? 'Reprogramar' : 'Programar control' %></button>
    </form>
    <p class="hint">Sugerido: <%= settings.diasControl %> días después de la última toma. Un control nuevo reemplaza al pendiente.</p>
  </section>
</div>

<section class="card" id="desenlace" aria-labelledby="out-title">
  <h2 id="out-title" class="card__title">Desenlace real</h2>
  <p class="muted small">Se registra por paciente al finalizar el seguimiento y alimenta la validación del modelo.</p>
  <%- include('../partials/outcome-form', { patient: p, volver: `/medico/estudios/${s.id}#desenlace` }) %>
</section>
