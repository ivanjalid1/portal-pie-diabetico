<!doctype html>
<html lang="es-AR">
<head>
  <%- include('../partials/head') %>
</head>
<body class="public<%= currentPath === '/login' ? ' public--auth' : '' %>">
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <% if (currentPath !== '/login') { %>
  <header class="public-header">
    <a href="/" class="brand">
      <img src="/img/logo.svg" alt="" width="34" height="34">
      <span class="brand__text"><strong><%= appName %></strong><small>Termografía plantar</small></span>
    </a>
    <nav aria-label="Principal" class="public-header__nav">
      <%- include('../partials/theme-toggle') %>
      <% if (user) { %>
      <a class="btn btn--ghost" href="<%= ROLE_HOME[user.role] %>">Ir a mi panel</a>
      <% } else { %>
      <a class="btn btn--primary" href="/login">Ingresar</a>
      <% } %>
    </nav>
  </header>
  <% } %>
  <main id="contenido" tabindex="-1">
    <%- body %>
  </main>
  <%- include('../partials/flash') %>
</body>
</html>
