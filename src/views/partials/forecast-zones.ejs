<%
  // Pronóstico por pie × zona para el próximo control (ThermalForecastService).
  // Parámetros: forecast (con disponible = true), etiqueta (horizonte), umbral (°C por punto).
  const F = forecast;
  const lim = Math.min(100, Math.max(40, Math.ceil(Math.max(...F.pies.flatMap((p) => p.zonas.flatMap((z) => [z.actual ? z.actual.areaPct : 0, z.esperado ? z.esperado.rango[1] : 0]))) / 10) * 10));
  const pos = (v) => `${Math.max(0, Math.min(100, (v / lim) * 100)).toFixed(1)}%`;
  const TREND = {
    empeora: { label: 'Empeora', icon: 'trendUp' },
    estable: { label: 'Estable', icon: 'minus' },
    mejora: { label: 'Mejora', icon: 'trendDown' },
  };
  const corte = fmt.num(F.areaMinima, 0);
%>
<section class="card fc-card" aria-labelledby="fc-title">
  <div class="fc-card__head">
    <div>
      <h2 id="fc-title" class="card__title">Pronóstico por zona</h2>
      <p class="fc-card__sub">Próximo control (<%= etiqueta %>) · desde la toma <%= F.desdeToma %></p>
    </div>
    <ul class="fc-legend" aria-hidden="true">
      <li><span class="fc-key fc-key--now"></span>Actual</li>
      <li><span class="fc-key fc-key--exp"></span>Esperado</li>
      <li><span class="fc-key fc-key--band"></span>Rango 80 %</li>
      <li><span class="fc-key fc-key--thr"></span><%= corte %> %</li>
    </ul>
  </div>

  <% if (F.persistentes.length) { %>
  <p class="fc-persist" role="note">
    <%- include('icon', { name: 'alert', size: 16 }) %>
    <span><strong><%= F.persistentes.length > 1 ? 'Zonas calientes persistentes' : 'Zona caliente persistente' %>:</strong> <%= F.persistentes.map((z) => z.texto).join(', ') %> <span class="fc-persist__sub">(≥ <%= corte %> % en 2 tomas)</span></span>
  </p>
  <% } %>

  <div class="fc-feet">
    <% F.pies.forEach((p) => { %>
    <div class="fc-foot">
      <h3 class="fc-foot__title">Pie <%= p.nombre %></h3>
      <div class="fc-cols" aria-hidden="true"><span>Zona</span><span>Área caliente</span><span>Actual → esperado</span><span>Tendencia</span><span>Prob. caliente</span></div>
      <ul class="fc-zones">
        <% p.zonas.forEach((z) => { const zn = z.nombre.charAt(0).toUpperCase() + z.nombre.slice(1); %>
        <% if (!z.actual || !z.esperado) { %>
        <li class="fc-zone is-na"><span class="fc-zone__name"><%= zn %></span><span class="fc-zone__na">No analizada en la toma <%= F.desdeToma %></span></li>
        <% } else { const e = z.esperado; const t = TREND[z.tendencia]; %>
        <li class="fc-zone<%= z.persistente ? ' is-persistent' : '' %>" aria-label="<%= zn %>, pie <%= p.nombre %>: <%= fmt.num(z.actual.areaPct, 0) %> % ahora, <%= fmt.num(e.areaPct, 0) %> % esperado (<%= fmt.num(e.rango[0], 0) %>–<%= fmt.num(e.rango[1], 0) %> %), <%= t.label.toLowerCase() %>, probabilidad de zona caliente <%= fmt.num(z.prob * 100, 0) %> %<%= z.persistente ? ', zona caliente persistente' : '' %>">
          <span class="fc-zone__name"><%= zn %><% if (z.persistente) { %><span class="fc-zone__tag">Persistente</span><% } %></span>
          <span class="fc-track" aria-hidden="true">
            <span class="fc-track__thr" style="left: <%= pos(F.areaMinima) %>"></span>
            <span class="fc-track__band" style="left: <%= pos(e.rango[0]) %>; right: calc(100% - <%= pos(e.rango[1]) %>)"></span>
            <span class="fc-track__link" style="left: <%= pos(Math.min(z.actual.areaPct, e.areaPct)) %>; right: calc(100% - <%= pos(Math.max(z.actual.areaPct, e.areaPct)) %>)"></span>
            <span class="fc-track__now" style="left: <%= pos(z.actual.areaPct) %>"></span>
            <span class="fc-track__exp" style="left: <%= pos(e.areaPct) %>"></span>
          </span>
          <span class="fc-zone__vals num" aria-hidden="true"><%= fmt.num(z.actual.areaPct, 0) %> % <span class="fc-arrow">→</span> <strong><%= fmt.num(e.areaPct, 0) %> %</strong> <small><%= fmt.num(e.rango[0], 0) %>–<%= fmt.num(e.rango[1], 0) %></small></span>
          <span class="fc-trend fc-trend--<%= z.tendencia %>" aria-hidden="true"><%- include('icon', { name: t.icon, size: 14 }) %><%= t.label %></span>
          <span class="fc-prob num" aria-hidden="true"><span class="fc-prob__lbl">Prob. </span><%= fmt.num(z.prob * 100, 0) %> %</span>
        </li>
        <% } %>
        <% }) %>
      </ul>
    </div>
    <% }) %>
  </div>
  <p class="fc-card__foot">Área caliente: % de la zona más de <%= fmt.num(umbral, 1) %> °C más caliente que el otro pie. Prob. caliente: probabilidad de que la zona tenga al menos un <%= fmt.num(F.areaUmbral, 0) %> % de área caliente en el próximo control.</p>
</section>
