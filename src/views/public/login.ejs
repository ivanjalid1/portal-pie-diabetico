<section class="auth">
  <div class="auth__panel">
    <h1>Ingresar</h1>
    <p class="muted">Usá el correo con el que te registró tu médico (por ejemplo, tu cuenta de Gmail).</p>
    <form method="post" action="/login" class="form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field<%= errors.email ? ' has-error' : '' %>">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" autocomplete="username" inputmode="email" required value="<%= old.email || '' %>" placeholder="nombre@gmail.com"<%- errors.email ? ' aria-invalid="true" aria-describedby="email-error"' : '' %>>
        <% if (errors.email) { %><p class="field__error" id="email-error"><%= errors.email %></p><% } %>
      </div>
      <div class="field<%= errors.password ? ' has-error' : '' %>">
        <label for="password">Contraseña</label>
        <div class="input-group">
          <input id="password" name="password" type="password" autocomplete="current-password" required<%- errors.password ? ' aria-invalid="true"' : '' %>>
          <button type="button" class="icon-btn" data-toggle-password="password" aria-label="Mostrar contraseña"><%- include('../partials/icon', { name: 'eye', size: 18 }) %></button>
        </div>
        <% if (errors.password) { %><p class="field__error"><%= errors.password %></p><% } %>
      </div>
      <button type="submit" class="btn btn--primary btn--block btn--lg">Ingresar</button>
      <p class="hint">El ingreso con Google estará disponible en una próxima versión.</p>
    </form>
  </div>

  <% if (demoAccounts.length) { %>
  <aside class="demo-box" aria-labelledby="demo-title">
    <h2 id="demo-title">Cuentas demo</h2>
    <p class="muted">Contraseña para todas: <code class="copyable">Demo1234!</code></p>
    <ul>
      <% demoAccounts.forEach((acc) => { %>
      <li>
        <button type="button" class="demo-account" data-fill-login data-email="<%= acc.email %>" data-password="Demo1234!">
          <span class="demo-account__role"><%= acc.rol %></span>
          <span class="demo-account__email"><%= acc.email %></span>
          <span class="demo-account__desc"><%= acc.descripcion %></span>
        </button>
      </li>
      <% }) %>
    </ul>
    <p class="hint">Tocá una cuenta para completar el formulario.</p>
  </aside>
  <% } %>
</section>
