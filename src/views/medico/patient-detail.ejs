<%
  const p = patient;
  const alertaHb = p.hba1cAlerta();
  const hbLabels = { imputada: 'Imputada', sin_fecha: 'Sin fecha', desactualizada: 'Más de 12 meses', sin_dato: 'Sin dato' };
  const last = items.find((i) => i.analysis);
  const yn = (v) => (v ? 'Sí' : 'No');
  const vib = (v, m) => (m ? '> 50' : v === null ? '—' : fmt.num(v, 0));
  const vigente = consents.find((c) => c.vigente);
%>
<%- include('../partials/page-header', {
  heading: p.nombreCompleto,
  back: { href: '/medico/pacientes', label: 'Pacientes' },
  actions: `<a class="btn btn--ghost" href="/medico/pacientes/${p.id}/editar">${include('../partials/icon', { name: 'edit', size: 18 })}Editar datos</a>` + (p.consentimientoFirmado ? `<a class="btn btn--primary" href="/medico/estudios/nuevo?paciente=${p.id}">${include('../partials/icon', { name: 'scan', size: 18 })}Nuevo estudio</a>` : '')
}) %>

<div class="patient-strip">
  <span class="code code--lg"><%= p.codigo %></span>
  <span><%= p.edad() !== null ? `${p.edad()} años` : 'Edad sin dato' %><%= p.sexo === 'F' ? ', femenino' : p.sexo === 'M' ? ', masculino' : '' %></span>
  <span><%= p.tipoDm ? `DM tipo ${p.tipoDm}` : 'DM tipo sin dato' %><%= p.aniosEvolucionDm !== null ? `, ${fmt.num(p.aniosEvolucionDm, 1)} años` : '' %></span>
  <span><%= p.centro %></span>
  <% if (last) { %><%- include('../partials/risk-badge', { analysis: last.analysis, showPct: true }) %><% if (last.analysis.puntualActual) { %><span class="badge badge--<%= last.analysis.puntualActual.conAsimetria ? 'danger' : 'ok' %>"><%= last.analysis.puntualActual.conAsimetria ? 'Con asimetría punto a punto' : 'Sin asimetría punto a punto' %></span><% } %><% } %>
  <% if (!p.consentimientoFirmado) { %><span class="badge badge--danger">Sin consentimiento vigente</span><% } %>
  <% const exTesis = pw.etiquetaExclusionTesis(p); if (exTesis) { %><span class="badge badge--outline" data-exclusion-tesis title="Marca histórica de la planilla clínica. Sus estudios se evalúan con los mismos criterios de calidad de foto que el resto; sigue fuera del entrenamiento de los modelos."><%= exTesis %></span><% } %>
</div>

<div class="grid grid--main">
  <div class="stack-lg">
    <section class="card pw-card" aria-labelledby="pw-title">
      <div class="card__head">
        <h2 id="pw-title" class="card__title">Análisis punto a punto</h2>
        <% if (last) { %><a class="link small" href="/medico/estudios/<%= last.study.id %>">Ver estudio completo</a><% } %>
      </div>
      <% const lastPw = last && last.analysis.puntual; %>
      <% if (lastPw) { const la = last.analysis; const data = pw.payload(la); const srcId = `pw-pd-${last.study.id}`; const tA = la.puntualActual; const z = pw.zonasTexto(tA); %>
      <script type="application/json" id="<%= srcId %>" data-pw-data><%- pw.json(data) %></script>
      <div class="pw-evo">
        <div>
          <h3 class="card__subtitle">Riesgo de úlcera y área con diferencia entre pies, por toma</h3>
          <% const FCL = pronosticoDe(la); %>
          <%- include('../partials/pw-evolution', { serie: seriePuntual, areaMinima: lastPw.umbralPixel ? lastPw.areaMinima : 10, pronostico: FCL && FCL.planta, etiqueta: settings.pronosticoEtiqueta }) %>
          <% const RL = pw.riesgoDe(la); if (RL) { %>
          <p class="muted small">Línea violeta: riesgo de úlcera en <%= pw.horizonteTexto(RL.horizonteSemanas) %> (eje derecho), estimado con la asimetría de cada toma y la evidencia publicada<%= RL.grupoIwgdf !== null && RL.grupoIwgdf !== undefined ? ` (IWGDF ${RL.grupoIwgdf})` : '' %>.</p>
          <% } %>
        </div>
        <div>
          <h3 class="card__subtitle">Mapa ΔT izq. − der. <%= lastPw.tieneToma2 ? 'por toma' : '(toma 1)' %></h3>
          <div class="pw-evo__maps">
            <% lastPw.tomas.forEach((t) => { %>
            <figure class="pw-map pw-map--dt">
              <canvas data-pw-map="<%= t.toma %>:dt" data-pw-src="<%= srcId %>" role="img" aria-label="Mapa de diferencias, toma <%= t.toma %>"></canvas>
              <figcaption>Toma <%= t.toma %> · <span class="num"><%= t.metricas ? fmt.num(t.metricas.areaCalientePct, 1) : '—' %> %</span></figcaption>
            </figure>
            <% }) %>
            <% if (!lastPw.tieneToma2) { %>
            <div class="pw-map pw-map--empty image-tile__file--empty"><span class="small muted">Sin toma 2</span></div>
            <% } %>
          </div>
          <div class="pw-legend">
            <span class="pw-legend__bar pw-legend__bar--div"></span>
            <span class="pw-legend__ticks num"><span>−3</span><span>0</span><span>+3 °C</span></span>
            <span class="pw-legend__label">Rojo: izquierdo más caliente · azul: derecho · contorno: |ΔT| &gt; <%= fmt.num(lastPw.umbralPixel, 1) %> °C</span>
          </div>
          <% if (z) { %><p class="small text-warn">En el último estudio no se analizó: <%= z.noAnalizado %>. Se analizó: <%= z.analizado %>.</p><% } %>
        </div>
      </div>
      <% } else if (last) { %>
      <div class="empty empty--inline"><p>El último estudio no tiene análisis punto a punto (imágenes no radiométricas).</p></div>
      <% } else { %>
      <div class="empty empty--inline"><p>Sin estudios analizados todavía.</p></div>
      <% } %>
    </section>

    <section class="card card--flush">
      <div class="card__head card__head--pad"><h2 class="card__title">Estudios</h2></div>
      <% if (!items.length) { %>
      <div class="empty">
        <%- include('../partials/icon', { name: 'scan', size: 28 }) %>
        <h3>Sin estudios</h3>
        <p>Cargá la toma basal para obtener el primer análisis.</p>
        <% if (p.consentimientoFirmado) { %><a class="btn btn--primary" href="/medico/estudios/nuevo?paciente=<%= p.id %>">Cargar toma 1</a><% } %>
      </div>
      <% } else { %>
      <ol class="timeline">
        <% items.forEach(({ study, analysis }) => { %>
        <li class="timeline__item">
          <a href="/medico/estudios/<%= study.id %>" class="timeline__link">
            <span class="timeline__date"><strong><%= fmt.date(study.fechaHora) %></strong><small><%= analysis && analysis.puntual && !analysis.puntual.tieneToma2 ? 'Sólo toma 1' : `Toma 1: ${fmt.date(study.fechaToma1)}` %></small></span>
            <span class="timeline__body">
              <% const tA = analysis && analysis.puntualActual; %>
              <% if (tA && tA.metricas) { %>
              <span>Área con |ΔT| &gt; umbral <strong class="num"><%= fmt.num(tA.metricas.areaCalientePct, 1) %> %</strong> (toma <%= tA.toma %>)</span>
              <% } else if (analysis) { %>
              <span>ΔT máx. por región <strong class="num"><%= fmt.signed(analysis.deltaTMax) %> °C</strong></span>
              <% } %>
              <span class="timeline__tags">
                <% const FCi = analysis && analysis.puntual ? pronosticoDe(analysis) : null; if (FCi && FCi.alertas.length) { %><span class="badge badge--iwgdf" title="Criterio IWGDF de riesgo preulceroso (IWGDF 2023; Lavery 2007)">≥ 2,2 °C persistente · <%= FCi.alertas.map((z) => z.texto).join(', ') %></span><% } %>
                <% if (!study.valida) { %><span class="badge badge--warn">Imagen no válida</span><% } %>
                <% if (study.tempAmbiente !== null && !study.condiciones(paramsOf(analysis).protocolo).ok) { %><span class="badge badge--warn">Condiciones fuera de rango</span><% } %>
                <% if (analysis && analysis.puntual && !analysis.puntual.tieneToma2) { %><span class="badge badge--outline">Sin toma 2</span><% } %>
                <% if (tA && tA.zonasNoAnalizadas.length) { %><span class="badge badge--warn">Zonas no analizadas</span><% } %>
              </span>
            </span>
            <span class="timeline__result">
              <%- include('../partials/risk-badge', { analysis, showPct: true }) %>

            </span>
          </a>
        </li>
        <% }) %>
      </ol>
      <% } %>
    </section>

    <section class="card" id="desenlace">
      <h2 class="card__title">Desenlace del seguimiento</h2>
      <%- include('../partials/outcome-form', { patient: p }) %>
    </section>
  </div>

  <div class="stack-lg">
    <section class="card">
      <h2 class="card__title">Resumen clínico</h2>
      <dl class="kv kv--compact">
        <div><dt>Insulinorequiriente</dt><dd><%= yn(p.insulinorequiriente) %></dd></div>
        <div><dt>HbA1c</dt><dd><% if (p.hba1c !== null) { %><span class="num"><%= fmt.num(p.hba1c, 1) %> %</span> <span class="muted small"><%= fmt.date(p.hba1cFecha) %></span><% } else { %>—<% } %><% if (alertaHb) { %> <span class="badge badge--warn"><%= hbLabels[alertaHb] %></span><% } %></dd></div>
        <% if (p.hba1cNota) { %><div><dt>Nota HbA1c</dt><dd><%= p.hba1cNota %></dd></div><% } %>
        <div><dt>Tabaquismo</dt><dd><%= p.tabaquismo === null ? 'A consultar' : yn(p.tabaquismo) %></dd></div>
        <div><dt>Neuropatía</dt><dd><%= p.neuropatia ? `${p.gradoNeuropatia} (${p.neuropatiaPuntaje} pts)` : 'No' %></dd></div>
        <div><dt>Vibratoria der. / izq.</dt><dd class="num"><span class="<%= p.vibratoriaDerAlterada ? 'text-warn' : '' %>"><%= vib(p.vibratoriaDer, p.vibratoriaDerMas50) %></span> / <span class="<%= p.vibratoriaIzqAlterada ? 'text-warn' : '' %>"><%= vib(p.vibratoriaIzq, p.vibratoriaIzqMas50) %></span> µV</dd></div>
        <div><dt>Úlcera previa</dt><dd><%= p.ulceraPreviaDer && p.ulceraPreviaIzq ? 'Ambos pies' : p.ulceraPreviaDer ? 'Pie derecho' : p.ulceraPreviaIzq ? 'Pie izquierdo' : 'No' %></dd></div>
        <div><dt>Isquemia</dt><dd><%= yn(p.isquemia) %></dd></div>
        <div><dt>Hallazgos</dt><dd>
          <% const hall = [p.ampollas && 'ampollas', p.hiperqueratosis && 'hiperqueratosis', p.eritema && 'eritema', p.hematomas && 'hematomas'].filter(Boolean); %>
          <%= hall.length ? hall.join(', ') : 'Sin hallazgos' %>
          <% if (p.hiperqueratosisLocalizacion) { %><small class="muted block"><%= p.hiperqueratosisLocalizacion %></small><% } %>
        </dd></div>
        <% if (p.pesoKg) { %><div><dt>Peso</dt><dd class="num"><%= fmt.num(p.pesoKg, 0) %> kg</dd></div><% } %>
        <% if (p.indiceTobilloBrazo) { %><div><dt>Índice tobillo-brazo</dt><dd class="num"><%= fmt.num(p.indiceTobilloBrazo, 2) %></dd></div><% } %>
        <% if (p.cirugiasPrevias) { %><div><dt>Cirugías previas</dt><dd><%= p.cirugiasPrevias %></dd></div><% } %>
        <% if (p.observaciones) { %><div><dt>Observaciones</dt><dd><%= p.observaciones %></dd></div><% } %>
      </dl>
    </section>

    <section class="card">
      <h2 class="card__title">Contacto</h2>
      <dl class="kv kv--compact">
        <div><dt>Usuario</dt><dd><%= p.email %></dd></div>
        <div><dt>Teléfono</dt><dd><%= p.telefono || '—' %></dd></div>
        <% if (p.dni) { %><div><dt>DNI</dt><dd class="num"><%= p.dni %></dd></div><% } %>
      </dl>
    </section>

    <section class="card">
      <div class="card__head"><h2 class="card__title">Controles</h2><a class="link" href="/medico/controles">Ver todos</a></div>
      <% const ctrl = appointments.filter((a) => a.estado !== 'reprogramado').slice().sort((x, y) => new Date(y.fecha) - new Date(x.fecha)); %>
      <% if (!ctrl.length) { %><p class="muted">Sin controles. Programalo desde el resultado de un estudio.</p><% } %>
      <ol class="ctl-timeline">
        <% ctrl.forEach((a) => { const late = a.vencido(); const st = late ? 'vencido' : a.estado; %>
        <li class="ctl-timeline__item ctl-timeline__item--<%= st %>">
          <span class="ctl-timeline__dot" aria-hidden="true"></span>
          <div class="ctl-timeline__body">
            <div class="ctl-timeline__head">
              <strong class="num"><%= fmt.date(a.fecha) %></strong>
              <span class="badge badge--<%= { pendiente: 'info', vencido: 'warn', realizado: 'ok', ausente: 'warn', cancelado: 'muted' }[st] %>"><%= { pendiente: 'Programado', vencido: 'Vencido', realizado: 'Realizado', ausente: 'Ausente', cancelado: 'Cancelado' }[st] %></span>
            </div>
            <small class="muted"><%= a.motivo %><% if (a.realizadoEn) { %> · realizado el <%= fmt.date(a.realizadoEn) %><% } %></small>
            <% if (a.motivoAusencia) { %><small class="text-warn"><%= a.motivoAusencia %></small><% } %>
            <% if (a.studyId) { %><a class="link small" href="/medico/estudios/<%= a.studyId %>">Ver estudio</a><% } %>
          </div>
        </li>
        <% }) %>
      </ol>
    </section>

    <section class="card" id="consentimiento">
      <h2 class="card__title">Consentimiento informado</h2>
      <% if (vigente) { %>
      <p class="consent consent--ok"><%- include('../partials/icon', { name: 'shield', size: 18 }) %><span>Vigente: <%= vigente.version %>, firmado el <%= fmt.date(vigente.fechaFirma) %>.</span></p>
      <details class="disclosure">
        <summary>Registrar revocación</summary>
        <form method="post" action="/medico/pacientes/<%= p.id %>/consentimiento/revocar" class="form" data-confirm="¿Registrar la revocación? No se podrán cargar nuevos estudios del paciente.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field<%= errors.motivo ? ' has-error' : '' %>">
            <label for="motivo">Motivo</label>
            <input id="motivo" name="motivo" required minlength="3">
            <% if (errors.motivo) { %><p class="field__error"><%= errors.motivo %></p><% } %>
          </div>
          <button type="submit" class="btn btn--danger-ghost btn--sm">Registrar revocación</button>
        </form>
      </details>
      <% } else { %>
      <p class="consent consent--no"><%- include('../partials/icon', { name: 'ban', size: 18 }) %><span>Sin consentimiento vigente: no se pueden cargar estudios.</span></p>
      <form method="post" action="/medico/pacientes/<%= p.id %>/consentimiento" class="form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field<%= errors.fechaFirma ? ' has-error' : '' %>">
          <label for="fechaFirma">Fecha de firma</label>
          <input id="fechaFirma" name="fechaFirma" type="date" required value="<%= fmt.inputDate(new Date()) %>">
          <% if (errors.fechaFirma) { %><p class="field__error"><%= errors.fechaFirma %></p><% } %>
        </div>
        <label class="check<%= errors.confirmo ? ' has-error' : '' %>"><input type="checkbox" name="confirmo" required><span>El paciente firmó el documento <%= domain.CONSENT_VERSION %></span></label>
        <button type="submit" class="btn btn--primary btn--sm">Registrar consentimiento</button>
      </form>
      <% } %>
      <% if (consents.length) { %>
      <h3 class="card__subtitle">Historial</h3>
      <ul class="history">
        <% consents.forEach((c) => { %>
        <li><span class="num"><%= fmt.date(c.fechaFirma) %></span> <%= c.version %><% if (c.revocadoAt) { %> <span class="badge badge--muted">Revocado <%= fmt.date(c.revocadoAt) %></span><small class="muted block"><%= c.motivoRevocacion %></small><% } else { %> <span class="badge badge--ok">Vigente</span><% } %></li>
        <% }) %>
      </ul>
      <% } %>
    </section>
  </div>
</div>
