<%
  // Evolución punto a punto del paciente: % de área con |ΔT| sobre el umbral
  // en cada toma (línea naranja) y riesgo de úlcera estimado hasta esa toma
  // (línea violeta discontinua, eje derecho con escala propia: los riesgos de
  // pocas semanas suelen ser bajos). `serie` viene de PatientService.history.
  // `pronostico` (opcional): área esperada en el próximo control desde la última
  // toma ({ esperado, rango }, ThermalForecastService) → tramo discontinuo con banda.
  const pts = serie.filter((p) => p.areaCalientePct !== null);
  const fc = typeof pronostico !== 'undefined' && pronostico && pts.length ? pronostico : null;
  const fcLabel = typeof etiqueta !== 'undefined' && etiqueta ? etiqueta : '';
  const slots = pts.length + (fc ? 1 : 0);
  const W = 400, H = 220, padL = 34, padR = 36, padT = 20, padB = 38;
  const iw = W - padL - padR, ih = H - padT - padB;
  const maxArea = Math.max(20, Math.ceil(Math.max(...pts.map((p) => p.areaCalientePct), areaMinima, fc ? fc.rango[1] : 0) / 10) * 10);
  // Con pronóstico, el último punto se aparta del eje derecho para no tapar sus marcas.
  const xw = fc ? iw - 18 : iw;
  const x = (i) => padL + (slots === 1 ? xw / 2 : (i * xw) / (slots - 1));
  const yA = (v) => padT + ih - (v / maxArea) * ih;
  const probPts = pts.map((p, i) => [i, p.riesgo]).filter(([, v]) => v !== null && v !== undefined);
  const rMax = (() => {
    const m = Math.max(1, ...probPts.map(([, v]) => v));
    const steps = [1, 2, 5, 10, 20, 50, 100];
    return steps.find((st) => st >= m) || 100;
  })();
  const yP = (v) => padT + ih - (v / rMax) * ih;
%>
<div class="pw-evo__chart">
  <svg viewBox="0 0 <%= W %> <%= H %>" role="img" aria-label="Evolución del área con diferencia sobre el umbral y del riesgo de úlcera en <%= pts.length %> tomas">
    <% [0, 0.5, 1].forEach((k) => { const yy = padT + ih - k * ih; %>
    <line class="axis" x1="<%= padL %>" x2="<%= W - padR %>" y1="<%= yy %>" y2="<%= yy %>"/>
    <text class="tick" x="<%= padL - 6 %>" y="<%= yy + 3 %>" text-anchor="end"><%= Math.round(maxArea * k) %> %</text>
    <% if (probPts.length) { %><text class="tick" x="<%= W - padR + 6 %>" y="<%= yy + 3 %>"><%= fmt.num(rMax * k, rMax * k < 1 && k > 0 ? 1 : 0) %> %</text><% } %>
    <% }) %>
    <line class="thr" x1="<%= padL %>" x2="<%= W - padR %>" y1="<%= yA(areaMinima) %>" y2="<%= yA(areaMinima) %>"/>
    <% if (probPts.length > 1) { %><polyline class="prob-line" points="<%= probPts.map(([i, v]) => `${x(i).toFixed(1)},${yP(v).toFixed(1)}`).join(' ') %>"/><% } %>
    <% if (fc) { const xl = x(pts.length - 1), xf = x(pts.length), yl = yA(pts.at(-1).areaCalientePct), yf = yA(fc.esperado); const rTxt = `${fmt.num(fc.rango[0], 0)}–${fmt.num(fc.rango[1], 0)} %`; %>
    <g class="fc">
      <rect class="fc-band" x="<%= (xf - 7).toFixed(1) %>" y="<%= yA(fc.rango[1]).toFixed(1) %>" width="14" height="<%= Math.max(2, yA(fc.rango[0]) - yA(fc.rango[1])).toFixed(1) %>" rx="5"/>
      <line class="fc-line" x1="<%= xl.toFixed(1) %>" y1="<%= yl.toFixed(1) %>" x2="<%= xf.toFixed(1) %>" y2="<%= yf.toFixed(1) %>"/>
      <circle class="fc-dot" cx="<%= xf.toFixed(1) %>" cy="<%= yf.toFixed(1) %>" r="4.5"><title>Esperado en el próximo control<%= fcLabel ? ` (${fcLabel})` : '' %>: <%= fmt.num(fc.esperado, 1) %> % (rango del 80 %: <%= rTxt %>)</title></circle>
      <text class="lbl lbl--fc" x="<%= xf.toFixed(1) %>" y="<%= (yA(fc.rango[1]) - 6).toFixed(1) %>" text-anchor="middle"><%= fmt.num(fc.esperado, 0) %> %</text>
      <text class="tick" x="<%= xf.toFixed(1) %>" y="<%= H - padB + 16 %>" text-anchor="middle">Próximo</text>
      <text class="tick" x="<%= xf.toFixed(1) %>" y="<%= H - padB + 28 %>" text-anchor="middle"><%= fcLabel || 'control' %></text>
    </g>
    <% } %>
    <% if (pts.length > 1) { %><polyline class="area-line" points="<%= pts.map((p, i) => `${x(i).toFixed(1)},${yA(p.areaCalientePct).toFixed(1)}`).join(' ') %>"/><% } %>
    <% probPts.forEach(([i, v]) => { %><rect class="prob-dot" x="<%= (x(i) - 4).toFixed(1) %>" y="<%= (yP(v) - 4).toFixed(1) %>" width="8" height="8" transform="rotate(45 <%= x(i).toFixed(1) %> <%= yP(v).toFixed(1) %>)"><title>Riesgo de úlcera hasta la toma <%= pts[i].toma %>: <%= pw.riesgoPct(v) %><%= pts[i].riesgoRango ? ` (${pw.riesgoRango(pts[i].riesgoRango)})` : '' %></title></rect><text class="lbl lbl--prob" x="<%= (x(i) + 8).toFixed(1) %>" y="<%= (yP(v) + 4).toFixed(1) %>"><%= pw.riesgoPct(v) %></text><% }) %>
    <% pts.forEach((p, i) => { %>
    <circle class="area-dot" cx="<%= x(i).toFixed(1) %>" cy="<%= yA(p.areaCalientePct).toFixed(1) %>" r="5"><title>Toma <%= p.toma %> (<%= fmt.date(p.fecha) %>): <%= fmt.num(p.areaCalientePct, 1) %> %</title></circle>
    <text class="lbl" x="<%= x(i).toFixed(1) %>" y="<%= (yA(p.areaCalientePct) - 10).toFixed(1) %>" text-anchor="middle"><%= fmt.num(p.areaCalientePct, 0) %> %</text>
    <text class="tick" x="<%= x(i).toFixed(1) %>" y="<%= H - padB + 16 %>" text-anchor="middle">Toma <%= p.toma %></text>
    <text class="tick" x="<%= x(i).toFixed(1) %>" y="<%= H - padB + 28 %>" text-anchor="middle"><%= fmt.date(p.fecha) %></text>
    <% }) %>
  </svg>
  <div class="pw-evo__legend">
    <span><i></i>Área con |ΔT| &gt; umbral (eje izq.)</span>
    <% if (probPts.length) { %><span><i class="prob"></i>Riesgo de úlcera (eje der.)</span><% } %>
    <% if (fc) { %><span><i class="fc"></i>Esperado en el próximo control (rango 80 %)</span><% } %>
    <span><i class="thr"></i>Área mínima <%= fmt.num(areaMinima, 0) %> %</span>
  </div>
</div>
