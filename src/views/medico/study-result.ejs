<%
  // Resultado de un estudio (vista del médico/a), centrado en el análisis punto a punto:
  // encabezado → resumen en lenguaje simple → mapas → avisos → detalle técnico plegado → acciones.
  // Las regiones de la Parte 1 (tesis previa) se siguen calculando, pero no se muestran acá.
  const a = analysis;
  const s = study;
  const p = patient;
  const P = paramsOf(a);
  const C = s.condiciones(P.protocolo);
  const PW = a && a.puntual;
  const DM = PW && PW.patronDm;
  const DMI = predictorInfo.patronDm;
  const R = a ? pw.riesgoDe(a) : null;
  const RB = R && R.bib;
  const t2 = PW ? PW.tieneToma2 : Boolean(s.image('toma2'));
  const tA = a && a.puntualActual;
  const mA = tA && tA.metricas;
  const lectura = PW && tA ? pw.lecturaToma(tA, PW.umbralPixel) : null;
  const cambio = PW && t2 ? pw.cambioArea(a) : null;
  const u = PW ? fmt.num(PW.umbralPixel, 1) : '';
  // Pronóstico por zona del próximo control (sin modelo local: sólo la marca de persistencia).
  const FC = PW ? pronosticoDe(a) : null;
  const FCI = FC && FC.disponible ? pronosticoInfo() : null;
  const fechaToma = (k) => (k === 1 ? s.fechaToma1 : s.fechaHora);
  const tomaLabel = (k) => (k === 1 ? 'Toma 1 · basal' : 'Toma 2 · control');
  const estimadas = ((s.notasMedico || '').match(/Fecha de la toma ([12](?: y [12])?) estimada/) || [])[1] || null;
  const maxContrib = DM && DM.factores.length ? Math.max(0.01, ...DM.factores.map((f) => Math.abs(f.contribucion))) : 1;
  const fmtFactor = (f) => (f.valor === null ? 'sin dato' : `${fmt.num(f.valor, f.unidad === '%' ? 1 : 2)} ${f.unidad}`);

  // Avisos: todo lo que condiciona la lectura, en un solo lugar.
  const avisos = [];
  if (PW) {
    if (!t2) avisos.push({ tono: 'info', texto: '<strong>Sin toma 2.</strong> Se analizó sólo la termografía basal; no hay comparación entre tomas.' });
    PW.tomas.forEach((t) => {
      const na = pw.noAnalizadoTexto(t);
      if (na) avisos.push({ tono: 'info', texto: `<strong>Toma ${t.toma}: ${na}.</strong> No se detectaron completos en ambos pies (fuera del cuadro o demasiado fríos); quedan fuera de las métricas y se ven en gris.` });
      if (t.calidad !== null && t.calidad < 0.6) avisos.push({ tono: 'warn', texto: `<strong>Toma ${t.toma}: segmentación a revisar.</strong> Los contornos de ambos pies coinciden poco (calidad ${fmt.num(t.calidad, 2)}); mirá la termografía original.` });
      const cf = pw.calidadFotosAviso(t);
      if (cf) avisos.push({ tono: 'warn', texto: `<strong>Toma ${t.toma}: calidad baja de la foto.</strong> ${cf.texto.charAt(0).toUpperCase() + cf.texto.slice(1)}. Interpretá el resultado con cautela; los avisos de cada réplica están en el visor.` });
    });
  }
  if (estimadas) avisos.push({ tono: 'info', texto: `<strong>Fecha estimada${estimadas.includes('y') ? 's' : ''}:</strong> toma ${estimadas}. El reloj de la cámara no estaba configurado.` });
  // Condiciones de la sala por toma (medidas o estimadas), contra el protocolo de Configuración.
  const PR = protocolo();
  const AMB = pw.ambientesDe(a, s);
  const tomasAmb = (t2 ? [1, 2] : [1]).map((k) => ({ k, ...pw.ambienteToma(AMB[k] || null, PR) }));
  const fueraAmb = tomasAmb.filter((x) => x.fuera.alguno);
  if (fueraAmb.length) avisos.push({ tono: 'warn', texto: `<strong>${fueraAmb.map((x) => `Toma ${x.k}`).join(' y ')} fuera del protocolo de ambiente</strong> (${fmt.num(PR.tempAmbiente.min, 0)}–${fmt.num(PR.tempAmbiente.max, 0)} °C, ${PR.humedadRelativa.min}–${PR.humedadRelativa.max} % HR)${fueraAmb.some((x) => x.origen === 'estimada') ? ', con la temperatura estimada en alguna toma' : ''}. Las temperaturas absolutas se muestran ajustadas a una sala de 22 °C; la asimetría (ΔT) no depende del ambiente.` });
  const esc = (x) => String(x).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  if (!s.valida) avisos.push({ tono: 'warn', texto: `<strong>Imágenes marcadas como no válidas.</strong>${s.motivoInvalidez ? ` Motivo: ${esc(s.motivoInvalidez)}` : ''}` });
  const avisoWarn = avisos.some((x) => x.tono === 'warn');
%>
<header class="page-header sr-header">
  <div class="page-header__text">
    <a class="back-link" href="/medico/pacientes/<%= p.id %>"><%- include('../partials/icon', { name: 'arrowLeft', size: 16 }) %>Ficha de <%= p.codigo %></a>
    <p class="sr-header__eyebrow">Estudio termográfico · análisis punto a punto</p>
    <h1><%= p.codigo %></h1>
    <p class="sr-header__meta">
      <span>Toma 1 <strong class="num"><%= fmt.date(s.fechaToma1) %></strong></span>
      <% if (t2) { %><span>Toma 2 <strong class="num"><%= fmt.date(s.fechaHora) %></strong><% if (s.diasEntreTomas !== null) { %> <span class="muted">(<%= s.diasEntreTomas %> días)</span><% } %></span><% } %>
      <% if (s.centro) { %><span class="muted"><%= s.centro %></span><% } %>
    </p>
    <ul class="sr-amb" aria-label="Condiciones de la sala">
      <% tomasAmb.forEach((x) => { %>
      <li class="sr-amb__item<%= x.fuera.alguno ? ' sr-amb__item--warn' : '' %>" title="<%= x.detalle || '' %>">
        <span class="toma-dot toma-dot--<%= x.k %>"></span><span class="sr-amb__toma">Toma <%= x.k %></span>
        <span class="num"><%= x.texto %></span><% if (x.origen) { %> <span class="sr-amb__origen">(<%= x.origen %>)</span><% } %>
        <% if (x.fuera.alguno) { %><span class="badge badge--warn sr-amb__badge">fuera de protocolo</span><% } %>
      </li>
      <% }) %>
    </ul>
    <div class="sr-chips">
      <% if (mA) { %>
      <span class="badge badge--<%= tA.conAsimetria ? 'danger' : 'ok' %>"><span class="dot" aria-hidden="true"></span><%= tA.conAsimetria ? 'Asimetría térmica' : 'Sin asimetría relevante' %></span>
      <% } else if (a && !PW) { %>
      <span class="badge badge--warn">Resultado simulado</span>
      <% } %>
      <% if (FC && FC.persistentes.length) { const nP = FC.persistentes.length; %>
      <span class="badge badge--persist" title="Más del <%= fmt.num(FC.areaMinima, 0) %> % de la zona caliente en la toma 1 y en la toma 2. La asimetría que persiste en mediciones sucesivas se considera preulcerosa (IWGDF 2023, recomendación 7; Lavery et al. 2007)."><%- include('../partials/icon', { name: 'alert', size: 14 }) %><%= nP > 1 ? 'Zonas calientes persistentes' : 'Zona caliente persistente' %>: <%= FC.persistentes.map((z) => z.texto).join(', ') %> (2 tomas)</span>
      <% } %>
      <span class="badge badge--muted"><%= t2 ? 'Toma 1 y toma 2' : 'Sólo toma 1' %></span>
      <% if (PW) { PW.tomas.forEach((t) => { const pf = pw.promedioFotos(t); if (pf) { %>
      <span class="badge badge--muted" data-promedio-fotos title="<%= pf.detalle %>"><%= PW.tomas.length > 1 ? `Toma ${t.toma}: ` : '' %><%= pf.corto %></span>
      <% } }) } %>
      <% const exTesis = pw.etiquetaExclusionTesis(p); if (exTesis) { %>
      <span class="badge badge--outline" data-exclusion-tesis title="Marca histórica de la planilla clínica: no afecta este análisis, que usa los mismos criterios de calidad de foto que el resto. El paciente sigue fuera del entrenamiento de los modelos."><%= exTesis %></span>
      <% } %>
      <span class="badge badge--outline"><%= s.publicado ? 'Visible para el paciente' : 'No visible para el paciente' %></span>
      <% if (typeof revision !== 'undefined' && revision && revision.resumen.total) { const RS = revision.resumen; %>
      <a class="badge badge--<%= RS.rechazado ? 'danger' : RS.pendiente ? 'muted' : 'ok' %> ir-count" href="#revision" data-ir-count title="Revisión manual de las fotos del visor">Fotos: <span data-ir-count-text><%= resumenTexto(RS) %></span></a>
      <% } %>
    </div>
  </div>
  <div class="page-header__actions">
    <% if (a) { %>
    <form method="post" action="/medico/estudios/<%= s.id %>/publicacion"<%- s.publicado ? ' data-confirm="¿Ocultar el resultado al paciente?"' : '' %>>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (!s.publicado) { %><input type="hidden" name="publicado" value="on"><% } %>
      <button type="submit" class="btn btn--ghost"><%- include('../partials/icon', { name: s.publicado ? 'lock' : 'eye', size: 18 }) %><%= s.publicado ? 'Ocultar al paciente' : 'Mostrar al paciente' %></button>
    </form>
    <% } %>
    <a class="btn btn--ghost" href="/medico/estudios/<%= s.id %>/informe" target="_blank" rel="noopener"><%- include('../partials/icon', { name: 'printer', size: 18 }) %>Exportar informe</a>
  </div>
</header>

<% if (!a) { %>
<div class="card"><div class="empty"><h2>El análisis no está disponible</h2><p>Volvé a cargar el estudio.</p></div></div>
<% } else { %>

<% if (FC && FC.alertas.length) { %>
<div class="iwgdf-alert" role="alert">
  <span class="iwgdf-alert__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'alert', size: 22 }) %></span>
  <div class="iwgdf-alert__body">
    <p class="iwgdf-alert__title">Asimetría ≥ <%= fmt.num(FC.umbralIwgdf, 1) %> °C persistente en <%= FC.alertas.map((z) => z.texto).join(', ') %> (2 tomas)</p>
    <p class="iwgdf-alert__sub">Criterio IWGDF de riesgo preulceroso: diferencia contralateral ≥ 2,2 °C en dos mediciones consecutivas. <%= FC.alertas.map((z) => `${z.texto.charAt(0).toUpperCase()}${z.texto.slice(1)}: p95 de la zona ${fmt.num(z.p95[0], 1)} → ${fmt.num(z.p95[1], 1)} °C`).join(' · ') %>.</p>
    <p class="iwgdf-alert__cite">IWGDF 2023 (Bus et al., doi:10.1002/dmrr.3651), recomendación 7; Lavery et al. 2007, Diabetes Care 30:14-20 (doi:10.2337/dc06-1600).</p>
  </div>
</div>
<% } %>

<section class="card sr-summary" aria-labelledby="sum-title">
  <h2 id="sum-title" class="sr-summary__eyebrow">Resultado<% if (tA) { %> · <%= tomaLabel(tA.toma).toLowerCase() %><% } %></h2>
  <% if (R) { const cat = domain.RISK_CATEGORIES[a.categoria]; %>
  <div class="sr-risk sr-risk--<%= cat.tono %>">
    <p class="sr-risk__label">
      Riesgo de úlcera en <%= pw.horizonteFrase(R.horizonteSemanas) %>
      <span class="sr-tip">
        <button type="button" class="help-dot" aria-describedby="tip-risk" aria-label="Cómo se estima el riesgo de úlcera">i</button>
        <span role="tooltip" id="tip-risk" class="sr-tip__body"><%= R.fuente === 'modelo' ? `Modelo entrenado con los desenlaces registrados en el portal (${R.modelo.positivos} lesiones; AUC ${fmt.num(R.modelo.auc, 2)}).` : pw.TOOLTIP_RIESGO %></span>
      </span>
    </p>
    <p class="sr-risk__value"><span class="num"><%= pw.riesgoNum(R.probabilidad) %></span><small> %</small></p>
    <p class="sr-risk__meta">
      <% if (R.rango) { %><span class="num">(<%= pw.riesgoRango(R.rango) %>)</span><% } %>
      <span class="badge badge--<%= cat.tono %>"><span class="dot" aria-hidden="true"></span><%= cat.nombre %></span>
      <% if (R.grupoIwgdf !== null && R.grupoIwgdf !== undefined) { %><span class="badge badge--outline">IWGDF <%= R.grupoIwgdf %><%= R.bib && R.bib.grupoPorDefecto ? ' (supuesto)' : R.bib && R.bib.grupoEstimado ? ' (estimado)' : '' %></span><% } %>
    </p>
  </div>
  <% } %>
  <% if (lectura) { %>
  <p class="sr-summary__lead"><%= lectura.frase %></p>
  <% if (cambio) { %><p class="sr-summary__sub"><%= cambio.frase %></p><% } %>
  <dl class="sr-stats">
    <div class="sr-stat<%= tA.conAsimetria ? ' is-hot' : '' %>">
      <dt>Planta con diferencia &gt; <%= u %> °C</dt>
      <dd class="num"><%= fmt.num(mA.areaCalientePct, 0) %><small> %</small></dd>
    </div>
    <div class="sr-stat">
      <dt>Diferencia máxima</dt>
      <dd class="num"><%= fmt.num(mA.maxAbs, 1) %><small> °C</small></dd>
      <dd class="sr-stat__note">En <%= pw.ZONA_CON_ARTICULO[mA.hotspot.zona] %>, más caliente el pie <%= mA.hotspot.pieMasCaliente %></dd>
    </div>
    <% if (cambio) { %>
    <div class="sr-stat">
      <dt>Cambio desde la toma 1</dt>
      <dd class="num"><%= fmt.signed(cambio.delta, 0) %><small> pts</small></dd>
      <dd class="sr-stat__note">del área con diferencia</dd>
    </div>
    <% } %>
  </dl>
  <% } else if (PW) { %>
  <p class="sr-summary__lead">No hubo puntos comparables en ambos pies: revisá la termografía original.</p>
  <% } else { %>
  <p class="sr-summary__lead">No se pudo hacer el análisis punto a punto porque las imágenes no son archivos radiométricos (.IS2).</p>
  <% } %>
</section>

<% if (avisos.length) { %>
<div class="notice <%= avisoWarn ? 'notice--warn' : '' %> sr-notes" role="note" aria-label="Avisos del estudio">
  <%- include('../partials/icon', { name: avisoWarn ? 'alert' : 'info', size: 18 }) %>
  <ul>
    <% avisos.forEach((x) => { %><li><%- x.texto %></li><% }) %>
  </ul>
</div>
<% } %>

<% if (PW) { %><%- include('../partials/pointwise-study', { analysis: a, study: s, forecast: FC, etiqueta: settings.pronosticoEtiqueta }) %><% } %>
<% if (FC && FC.disponible) { %><%- include('../partials/forecast-zones', { forecast: FC, etiqueta: settings.pronosticoEtiqueta, umbral: FC.umbralPixel ?? PW.umbralPixel }) %><% } %>
<% const hayVisor = typeof visor !== 'undefined' && visor && visor.length; %>
<% if (hayVisor) { %><%- include('../partials/thermo-viewer', { study: s, visor, revision: typeof revision !== 'undefined' ? revision : null, fecha: fechaToma, activa: PW ? PW.tomaActual : (t2 ? 2 : 1) }) %><% } %>

<details class="disclosure disclosure--card sr-tech" id="detalle">
  <summary>Detalle técnico</summary>
  <div class="sr-tech__body">
    <% if (PW) { %>
    <section class="sr-tech__block" aria-labelledby="tech-metrics">
      <h3 id="tech-metrics" class="card__subtitle">Métricas punto a punto</h3>
      <div class="table-wrap">
        <table class="table table--num table--dense">
          <caption class="sr-only">Métricas de la diferencia izquierdo − derecho por toma</caption>
          <thead><tr><th scope="col">Toma</th><th scope="col">Área &gt; umbral</th><th scope="col">|ΔT| medio</th><th scope="col">|ΔT| p95</th><th scope="col">|ΔT| máx.</th><th scope="col">Media con signo</th><th scope="col">Puntos</th><th scope="col">Mediana plantar</th><th scope="col">Calidad de registro</th><th scope="col">Fotos</th></tr></thead>
          <tbody>
            <% PW.tomas.forEach((t) => { const m = t.metricas; %>
            <tr>
              <th scope="row"><span class="toma-dot toma-dot--<%= t.toma %>"></span>Toma <%= t.toma %></th>
              <td><%= m ? fmt.num(m.areaCalientePct, 1) + ' %' : '—' %></td>
              <td><%= m ? fmt.num(m.mediaAbs, 2) : '—' %></td>
              <td><%= m ? fmt.num(m.p95Abs, 2) : '—' %></td>
              <td><%= m ? fmt.num(m.maxAbs, 2) : '—' %></td>
              <td><%= m ? fmt.signed(m.mediaConSigno, 2) : '—' %></td>
              <td><%= m ? m.celdas : '—' %></td>
              <td><%= t.absoluta ? (t.absoluta.medianaAjustadaC !== null ? `${fmt.num(t.absoluta.medianaAjustadaC, 1)} (cruda ${fmt.num(t.absoluta.medianaC, 1)})` : fmt.num(t.absoluta.medianaC, 1)) : '—' %></td>
              <td><%= t.calidad !== null ? fmt.num(t.calidad, 2) : '—' %></td>
              <% const pfT = pw.promedioFotos(t); const eT = t.calidadFotos && t.calidadFotos.promedio && t.calidadFotos.promedio.estabilidad; %>
              <td title="<%= pfT ? pfT.detalle : '' %>"><%= pfT ? pfT.corto : '—' %><% if (eT && eT.areaCalienteDe !== null) { %><span class="muted"> · área ± <%= fmt.num(eT.areaCalienteDe, 1) %> pts</span><% } %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="muted small">Valores en °C. ΔT = izquierdo − derecho espejado. La mediana plantar se ajusta a una sala de 22 °C (−<%= fmt.num(pw.AJUSTE_AMBIENTE.pendiente, 2) %> °C por °C de sala); las métricas de ΔT no se ajustan. <% PW.tomas.forEach((t) => { if (t.metricas) { %>Toma <%= t.toma %>: mayor diferencia en <%= pw.hotspotTexto(t.metricas) %> (<span class="num"><%= fmt.signed(t.metricas.hotspot.deltaT, 1) %> °C</span>). <% } }) %></p>
    </section>

    <section class="sr-tech__block" aria-labelledby="tech-hist">
      <h3 id="tech-hist" class="card__subtitle">Distribución de |ΔT| por punto</h3>
      <div class="sr-hists">
        <% PW.tomas.forEach((t) => { if (t.metricas) { %>
        <figure class="sr-hist">
          <canvas class="pw-hist" data-pw-hist="<%= t.toma %>" data-pw-src="pw-<%= s.id %>" data-height="130" role="img" aria-label="Histograma de la diferencia absoluta por punto, toma <%= t.toma %>: <%= fmt.num(t.metricas.areaCalientePct, 1) %> % sobre el umbral"></canvas>
          <figcaption><span class="toma-dot toma-dot--<%= t.toma %>"></span>Toma <%= t.toma %>. Las barras rojas superan el umbral.</figcaption>
        </figure>
        <% } }) %>
      </div>
    </section>

    <% if (PW.cambio) { %>
    <section class="sr-tech__block" aria-labelledby="tech-change">
      <h3 id="tech-change" class="card__subtitle">Cambio toma 1 → toma 2 por pie</h3>
      <div class="table-wrap">
        <table class="table table--num table--dense">
          <thead><tr><th scope="col">Pie</th><th scope="col">Cambio mediano</th><th scope="col">|Cambio| p95</th><th scope="col">Cambio local</th></tr></thead>
          <tbody>
            <% [['izq', 'Izquierdo'], ['der', 'Derecho']].forEach(([k, label]) => { const c = PW.cambio[k]; %>
            <tr><th scope="row"><%= label %></th><td><%= c ? fmt.signed(c.mediana, 2) + ' °C' : '—' %></td><td><%= c ? fmt.num(c.p95Abs, 2) + ' °C' : '—' %></td><td><%= c ? fmt.num(c.areaCambioLocalPct, 1) + ' %' : '—' %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="muted small">El cambio mediano refleja sobre todo el ambiente y el día; «cambio local» cuenta los puntos que se apartan de él más de <span class="num"><%= fmt.num(PW.umbralCambio, 1) %> °C</span>.</p>
    </section>
    <% } %>

    <section class="sr-tech__block" aria-labelledby="tech-params">
      <h3 id="tech-params" class="card__subtitle">Método y parámetros</h3>
      <dl class="kv kv--compact">
        <div><dt>Registro</dt><dd>Ambos pies segmentados, el derecho espejado y alineados por centroide, eje principal y escala en una grilla de <span class="num"><%= PW.grilla.w %> × <%= PW.grilla.h %></span>.</dd></div>
        <div><dt>Mapas</dt><dd>Se dibujan con interpolación bilineal entre puntos medidos (sin extrapolar) y el contorno del umbral sobre |ΔT| levemente suavizado; las métricas usan la grilla original.</dd></div>
        <div><dt>Umbral</dt><dd>Umbral por punto <strong class="num"><%= fmt.num(PW.umbralPixel, 1) %> °C</strong></dd></div>
        <div><dt>Área mínima</dt><dd><span class="num"><%= fmt.num(PW.areaMinima, 0) %> %</span> de la planta para marcar asimetría</dd></div>
        <div><dt>Cambio local</dt><dd>&gt; <span class="num"><%= fmt.num(PW.umbralCambio, 1) %> °C</span> respecto del cambio mediano del pie</dd></div>
        <div><dt>Segmentación</dt><dd><%= PW.tomas.map((t) => `Toma ${t.toma}: ${t.segmentacion === 'unet' ? 'U-Net' : 'clásica'}`).join(' · ') %><span class="muted"> · U-Net entrenada con etiquetas débiles; sin máscara U-Net, la clásica (umbral y crecimiento de regiones)</span></dd></div>
        <% const tciT = PW.tomas.filter((t) => t.tci); if (tciT.length) { const r0 = tciT[0].tci.referencia || {}; %>
        <div><dt>TCI</dt><dd><%= tciT.map((t) => `Toma ${t.toma}: ${fmt.num(t.tci.valor, 2)} °C (clase ${t.tci.clase}${t.tci.valorAjustado != null ? `; ajustado por ambiente ${fmt.num(t.tci.valorAjustado, 2)} °C, clase ${t.tci.claseAjustada}` : ''}; izq. ${fmt.num(t.tci.izq, 2)}, der. ${fmt.num(t.tci.der, 2)}; puntual ${fmt.num(t.tci.puntual, 2)})`).join(' · ') %>. Índice de cambio térmico (Hernández-Contreras et al., 2017): promedio de |T(angiosoma) − T(referencia)| en 4 angiosomas (<%= predictorInfo.tci ? predictorInfo.tci.angiosomas : 'aproximados' %>). Referencia: <%= r0.fuente === 'hernandez2019' ? `grupo control de la base pública 2019 (${r0.miembros} sujetos sin diabetes; otra cámara: el valor absoluto arrastra la diferencia de escala, el de patrón no)` : r0.fuente === 'cohorte' ? `${r0.miembros} pacientes simétricos de la cohorte${r0.looExcluido ? ' (sin este paciente)' : ''}` : 'pares de demostración' %>. De patrón: <%= tciT.map((t) => fmt.num(t.tci.patron, 2)).join(' / ') %> °C.</dd></div>
        <% } %>
        <div><dt>Análisis</dt><dd><code><%= a.predictorVersion %></code> <%= predictorInfo.nombre %></dd></div>
      </dl>
    </section>
    <% } %>

    <% if (RB) { const EV = (predictorInfo.riesgo || {}).evidencia || {}; %>
    <section class="sr-tech__block" aria-labelledby="tech-risk">
      <h3 id="tech-risk" class="card__subtitle">Riesgo de úlcera: cálculo</h3>
      <dl class="kv kv--compact">
        <div><dt>Fórmula</dt><dd>odds(riesgo) = odds(prior IWGDF) × LR de la banda de asimetría (un solo LR; teorema de Bayes)<% if (RB.compuesto) { %>, por período de 2 meses (≈ <span class="num"><%= fmt.num(RB.periodoSemanas, 1) %></span> semanas, la ventana de los LR según Lavery 2019) y compuesto en <span class="num"><%= fmt.num(RB.periodos, 1) %></span> períodos suponiendo que la asimetría se mantiene: 1 − (1 − riesgo del período)<sup>k</sup>. El rango incluye además el caso en que el hallazgo vale sólo para el primer período<% } %></dd></div>
        <div><dt>Prior</dt><dd>IWGDF <%= RB.grupoIwgdf %> (<%= RB.grupoMotivo %>): <span class="num"><%= pw.riesgoPct(RB.prior) %></span> en <%= pw.horizonteTexto(RB.horizonteSemanas) %>, desde la úlcera a 3 años de Peters y Lavery 2001 con riesgo constante<%= RB.grupoEstimado ? `; sin dato de neuropatía en la ficha, se mezclan los priors IWGDF 1 y 0 con la probabilidad de neuropatía del modelo (${fmt.num(RB.grupoEstimado.probNeuropatia, 1)} %)` : '' %></dd></div>
        <% const FR = PW && PW.factorRiesgo; if (FR) { %>
        <div><dt>Neuropatía (modelo)</dt><dd><span class="num"><%= fmt.num(FR.probabilidad, 1) %> %</span> con la toma <%= FR.toma %>. <%= FR.entrenamiento %>: n = <%= FR.n %> (<%= FR.positivos %> con neuropatía), AUC <span class="num"><%= fmt.num(FR.auc, 2) %></span> (IC 95 % <span class="num"><%= fmt.num(FR.aucIC95[0], 2) %>–<%= fmt.num(FR.aucIC95[1], 2) %></span>), dentro del Hospital Córdoba <span class="num"><%= fmt.num(FR.aucDentroDeCentro, 2) %></span>, p de permutación <span class="num"><%= fmt.num(FR.pPermutacion, 3) %></span>. <%= RB.grupoEstimado ? 'Define el prior.' : 'La ficha registra el dato: manda el dato clínico.' %></dd></div>
        <% } %>
        <div><dt>Asimetría</dt><dd>Zona caliente contigua de la toma <%= tA ? tA.toma : '' %>: <span class="num"><%= fmt.num(RB.asimetria, 2) %> °C</span><% if (RB.zona) { %> en <%= pw.ZONA_CON_ARTICULO[RB.zona] %>, más caliente el pie <%= RB.pieMasCaliente %> (<span class="num"><%= fmt.num(RB.areaZonaPct, 1) %> %</span> de la planta)<% } %>. <%= RB.confirmable ? (RB.persistente ? 'Persistente en ambas tomas.' : `No confirmada por la otra toma (persistente: ${fmt.num(RB.asimetriaConfirmada, 2)} °C).`) : 'Una sola toma: sin confirmación.' %></dd></div>
        <div><dt>Banda y LR</dt><dd><%= RB.banda.nombre %>: LR <span class="num"><%= fmt.num(RB.lr, 2) %></span> (<span class="num"><%= fmt.num(RB.lrRango[0], 2) %>–<%= fmt.num(RB.lrRango[1], 2) %></span>) · <%= predictorInfo.riesgo && predictorInfo.riesgo.modos ? predictorInfo.riesgo.modos[RB.modo] : RB.modo %></dd></div>
        <div><dt>Resultado</dt><dd><span class="num"><%= pw.riesgoPct(RB.probabilidad) %></span> (<span class="num"><%= pw.riesgoRango(RB.rango) %></span>)<%= R.fuente === 'modelo' ? ' · reemplazado por el modelo entrenado' : '' %>. Categoría: bajo &lt; <span class="num"><%= pw.riesgoPct(RB.cortes.moderado) %></span> (basal IWGDF 1) ≤ moderado &lt; <span class="num"><%= pw.riesgoPct(RB.cortes.alto) %></span> (basal IWGDF 3) ≤ alto</dd></div>
        <div><dt>Fuentes</dt><dd><% ['frykberg2017', 'lavery2019', 'peters2001', 'iwgdf2023'].forEach((k) => { const e = EV[k]; if (e) { %><span class="sr-cite"><%= e.cita %>. doi:<%= e.doi %> (<%= e.pagina %>).</span> <% } }) %></dd></div>
      </dl>
    </section>
    <% } %>

    <% if (FCI) { const cv = (k) => FCI[k]; %>
    <section class="sr-tech__block" aria-labelledby="tech-fc">
      <h3 id="tech-fc" class="card__subtitle">Pronóstico por zona: modelo</h3>
      <dl class="kv kv--compact">
        <div><dt>Validación</dt><dd>CV por paciente (<%= FCI.n.pacientes %> pacientes, <%= FCI.n.filasPieZona %> pie × zona, <%= FCI.horizonteDias.mediana %> días mediana). Área caliente: MAE <span class="num"><%= fmt.num(cv('area').mae, 1) %> pp</span> vs <span class="num"><%= fmt.num(cv('area').maePersistencia, 1) %></span> persistencia · ΔT: <span class="num"><%= fmt.num(cv('dT').mae, 2) %></span> vs <span class="num"><%= fmt.num(cv('dT').maePersistencia, 2) %> °C</span> · prob. caliente: AUC <span class="num"><%= fmt.num(FCI.prob.auc, 2) %></span> (<span class="num"><%= fmt.num(FCI.prob.aucIC95[0], 2) %>–<%= fmt.num(FCI.prob.aucIC95[1], 2) %></span>), persistencia <span class="num"><%= fmt.num(FCI.prob.aucPersistencia, 2) %></span>, pendiente de calibración <span class="num"><%= fmt.num(FCI.prob.pendienteCalibracion, 2) %></span><% if (FCI.pixel) { %> · mapa β = <span class="num"><%= fmt.num(FCI.pixel.beta, 2) %></span>: MAE <span class="num"><%= fmt.num(FCI.pixel.cv.mae, 2) %></span> vs <span class="num"><%= fmt.num(FCI.pixel.cv.maePersistencia, 2) %> °C</span><% } %><% if (FCI.retest) { %> · test-retest <span class="num"><%= fmt.num(FCI.retest.areaAbsMedia, 1) %> pp / <%= fmt.num(FCI.retest.pixelMae, 2) %> °C</span><% } %></dd></div>
      </dl>
    </section>
    <% } %>

    <section class="sr-tech__block" aria-labelledby="tech-model">
      <h3 id="tech-model" class="card__subtitle">Patrón térmico compatible con pie diabético (base pública)</h3>
      <% if (DM && DMI) { %>
      <dl class="kv kv--compact">
        <div><dt>Qué predice</dt><dd>Diabetes vs control en la base pública <em>Plantar Thermogram Database</em> (Hernández-Contreras et al. 2019, CC BY 4.0). <strong>No predice úlcera.</strong></dd></div>
        <div><dt>Modelo</dt><dd>Regresión logística L2 sobre features relativas a cada pie y contralaterales (invariantes a la cámara y a la escala de temperatura)</dd></div>
        <div><dt>Validación</dt><dd><%= DMI.metodo %>: AUC <span class="num"><%= fmt.num(DMI.auc, 3) %></span> (IC 95 % <span class="num"><%= fmt.num(DMI.aucIC95[0], 2) %>–<%= fmt.num(DMI.aucIC95[1], 2) %></span>); n = <%= DMI.n %> (<%= DMI.positivos %> con diabetes)<% if (DMI.pPermutacion !== null) { %>; p de permutación <span class="num"><%= fmt.num(DMI.pPermutacion, 3) %></span><% } %></dd></div>
        <% if (DMI.subgrupoEdad) { %><div><dt>Edad</dt><dd>Los controles de la base son más jóvenes: la edad sola da AUC <span class="num"><%= fmt.num(DMI.aucEdadSola, 2) %></span>. Entre 30 y 60 años (n = <%= DMI.subgrupoEdad.n %>) el modelo da <span class="num"><%= fmt.num(DMI.subgrupoEdad.auc, 2) %></span> y la edad sola <span class="num"><%= fmt.num(DMI.subgrupoEdad.aucEdadSola, 2) %></span>: parte de la discriminación puede ser edad.</dd></div><% } %>
        <div><dt>Resultado</dt><dd>Patrón térmico compatible con pie diabético: <span class="num"><%= fmt.num(DM.probabilidad, 1) %> %</span> con la toma <%= DM.tomaUsada %></dd></div>
      </dl>
      <% if (DM.factores.length) { %>
      <ul class="factors">
        <% DM.factores.forEach((f) => { %>
        <li>
          <span class="factors__name"><%= f.nombre %></span>
          <span class="factors__value"><%= fmtFactor(f) %></span>
          <span class="factors__bar<%= f.contribucion < 0 ? ' factors__bar--neg' : '' %>" aria-hidden="true"><span style="width: <%= Math.round((Math.abs(f.contribucion) / maxContrib) * 100) %>%"></span></span>
          <span class="factors__num num"><%= fmt.signed(f.contribucion, 2) %></span>
        </li>
        <% }) %>
      </ul>
      <p class="muted small">Las cuatro variables que más pesan en este estudio (contribución al log-odds). La base pública usa otra cámara, otro protocolo y otra población; en el portal la conversión a °C es aproximada.</p>
      <% } %>
      <% } else { %>
      <p class="muted small">Sin resultado: el análisis punto a punto no está disponible para este estudio.</p>
      <% } %>
      <p class="muted small">Dato secundario: no cambia el riesgo de úlcera ni su categoría. El modelo preliminar de HbA1c &gt; 7 % (desenlace sustituto) ya no se muestra: su AUC quedó por debajo del azar (ver la comparación).</p>
    </section>

    <% const CMP = predictorInfo.comparacion; if (CMP && CMP.modelos && CMP.modelos.length) { %>
    <section class="sr-tech__block" aria-labelledby="tech-cmp">
      <h3 id="tech-cmp" class="card__subtitle">Comparación de modelos (validación cruzada por paciente)</h3>
      <div class="table-wrap">
        <table class="table table--num table--dense">
          <caption class="sr-only">AUC de validación cruzada de cada modelo</caption>
          <thead><tr><th scope="col">Modelo</th><th scope="col">AUC</th><th scope="col">IC 95 %</th><th scope="col">n (positivos)</th></tr></thead>
          <tbody>
            <% CMP.modelos.forEach((m) => { %>
            <tr><th scope="row"><%= m.nombre %></th><td><%= fmt.num(m.auc, 2) %></td><td class="nowrap"><%= fmt.num(m.aucIC95[0], 2) %>–<%= fmt.num(m.aucIC95[1], 2) %></td><td><%= m.n %> (<%= m.positivos %>)</td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="muted small"><%= CMP.conclusion %></p>
    </section>
    <% if (CMP.ajustado) { const AJ = CMP.ajustado; %>
    <section class="sr-tech__block" aria-labelledby="tech-adj">
      <h3 id="tech-adj" class="card__subtitle">HbA1c &gt; 7 % con features invariantes y ajuste por centro (n = <%= AJ.n %>, <%= AJ.positivos %> positivos)</h3>
      <div class="table-wrap">
        <table class="table table--num table--dense">
          <caption class="sr-only">AUC con features invariantes a la adquisición</caption>
          <thead><tr><th scope="col">Modelo</th><th scope="col">AUC</th><th scope="col">IC 95 %</th><th scope="col">Dentro de centro</th></tr></thead>
          <tbody>
            <% AJ.modelos.forEach((m) => { %>
            <tr><th scope="row"><%= m.nombre %></th><td><%= fmt.num(m.auc, 2) %></td><td class="nowrap"><%= fmt.num(m.aucIC95[0], 2) %>–<%= fmt.num(m.aucIC95[1], 2) %></td><td><%= m.aucDentroDeCentro === null ? '—' : fmt.num(m.aucDentroDeCentro, 2) %><% if (m.pPermutacionDentroDeCentro !== null) { %> <span class="muted">(p <%= fmt.num(m.pPermutacionDentroDeCentro, 2) %>)</span><% } %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="muted small"><%= AJ.metodo %> <%= AJ.conclusion %></p>
    </section>
    <% } %>
    <% if (CMP.basePublica) { const BP = CMP.basePublica; %>
    <section class="sr-tech__block" aria-labelledby="tech-pub">
      <h3 id="tech-pub" class="card__subtitle">Base pública: <%= BP.etiqueta %></h3>
      <div class="table-wrap">
        <table class="table table--num table--dense">
          <caption class="sr-only">AUC de validación cruzada por sujeto en la base pública</caption>
          <thead><tr><th scope="col">Modelo</th><th scope="col">AUC</th><th scope="col">IC 95 %</th><th scope="col">n (diabetes)</th></tr></thead>
          <tbody>
            <% BP.modelos.forEach((m) => { %>
            <tr><th scope="row"><%= m.nombre %></th><td><%= fmt.num(m.auc, 2) %></td><td class="nowrap"><%= fmt.num(m.aucIC95[0], 2) %>–<%= fmt.num(m.aucIC95[1], 2) %></td><td><%= m.n %> (<%= m.positivos %>)</td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="muted small"><%= BP.metodo %><% if (BP.externa) { %> Cohorte del portal (toda con diabetes, sin controles: no hay AUC): puntaje mediano <%= fmt.num(BP.externa.percentiles_10_25_50_75_90[2] * 100, 0) %> % y <%= fmt.num(BP.externa.fraccionMayor50 * 100, 0) %> % de los pacientes sobre 50 % (n = <%= BP.externa.n %>).<% } %></p>
    </section>
    <% } %>
    <% } %>

    <section class="sr-tech__block" aria-labelledby="tech-acq">
      <h3 id="tech-acq" class="card__subtitle"><%= hayVisor ? 'Adquisición' : 'Termografías originales y adquisición' %></h3>
      <% if (hayVisor) { %>
      <p class="muted small">Las termografías originales se ven en el <a href="#visor">visor</a>, con fusión, alarma de color y lectura de temperatura.</p>
      <% } else { %>
      <div class="image-pair">
        <% imageSlots.forEach((sl) => { if (sl.toma === 2 && !s.image('toma2')) { %>
        <figure class="image-tile"><div class="image-tile__file image-tile__file--empty"><%- include('../partials/icon', { name: 'calendar', size: 24 }) %><span>Sin toma 2</span></div><figcaption><%= slotTitulo(sl) %></figcaption></figure>
        <% } else { %>
        <%- include('../partials/thermo-tile', { study: s, sl, sub: fmt.date(fechaToma(sl.toma)) + (sl.toma === 1 && s.toma1OrigenStudyId ? ' · reutilizada' : '') }) %>
        <% } }) %>
      </div>
      <% } %>
      <dl class="kv kv--compact kv--2col">
        <% tomasAmb.forEach((x) => { %>
        <div><dt>Ambiente toma <%= x.k %></dt><dd class="num"><%= x.texto %><%= x.origen ? ` (${x.origen})` : '' %><%= x.fuera.alguno ? ' · fuera de protocolo' : '' %><%= x.ajusteC ? ` · ajuste de temperaturas absolutas ${fmt.signed(x.ajusteC, 2)} °C` : '' %></dd></div>
        <% }) %>
        <% if (!t2) { %><div><dt>Ambiente toma 2</dt><dd>Sin toma 2</dd></div><% } %>
        <div><dt>Distancia</dt><dd class="num"><%= s.distanciaCm %> cm</dd></div>
        <div><dt>Emisividad</dt><dd class="num"><%= fmt.num(s.emisividad, 2) %></dd></div>
        <div><dt>Rango</dt><dd class="num"><%= s.rangoMin %>–<%= s.rangoMax %> °C</dd></div>
        <div><dt>Estabilización</dt><dd class="num"><%= s.tiempoEstabilizacionMin %> min</dd></div>
        <div><dt>Paleta</dt><dd><%= s.paleta %></dd></div>
        <div><dt>Fondo</dt><dd><%= s.fondo %></dd></div>
      </dl>
    </section>
  </div>
</details>
<% } %>

<div class="grid grid--2 sr-actions">
  <section class="card" id="notas" aria-labelledby="notes-title">
    <h2 id="notes-title" class="card__title">Notas del médico</h2>
    <form method="post" action="/medico/estudios/<%= s.id %>/notas" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="notasMedico" class="sr-only">Notas</label>
      <textarea id="notasMedico" name="notasMedico" rows="4" placeholder="Hallazgos de la inspección, indicaciones, derivaciones"><%= s.notasMedico %></textarea>
      <div class="form__actions"><button type="submit" class="btn btn--ghost btn--sm">Guardar notas</button></div>
    </form>
  </section>

  <section class="card" id="control" aria-labelledby="ctl-title">
    <h2 id="ctl-title" class="card__title">Próximo control</h2>
    <% if (proximo) { %>
    <p>Programado para el <strong><%= fmt.dateLong(proximo.fecha) %></strong> (<%= fmt.relativeDays(proximo.fecha) %>). <span class="muted"><%= proximo.motivo %></span></p>
    <% } else { %>
    <p class="muted">Sin control programado.</p>
    <% } %>
    <form method="post" action="/medico/estudios/<%= s.id %>/control" class="form form--inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field<%= errors.fecha ? ' has-error' : '' %>">
        <label for="fecha-control">Fecha</label>
        <input id="fecha-control" name="fecha" type="date" required value="<%= defaultControl %>">
      </div>
      <div class="field field--grow">
        <label for="motivo-control">Motivo</label>
        <input id="motivo-control" name="motivo" value="Control clínico posterior al estudio">
      </div>
      <button type="submit" class="btn btn--primary btn--sm"><%= proximo ? 'Reprogramar' : 'Programar control' %></button>
    </form>
    <p class="hint">Sugerido: <%= settings.diasControl %> días después de la última toma. Un control nuevo reemplaza al pendiente.</p>
  </section>
</div>

<section class="card" id="desenlace" aria-labelledby="out-title">
  <h2 id="out-title" class="card__title">Desenlace real</h2>
  <p class="muted small">Se registra por paciente al finalizar el seguimiento y alimenta la validación del modelo.</p>
  <%- include('../partials/outcome-form', { patient: p, volver: `/medico/estudios/${s.id}#desenlace` }) %>
</section>
