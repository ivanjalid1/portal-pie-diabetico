<%
  const g = (k) => groups.find((x) => x.key === k);
  const advKeys = defs.filter((d) => d.avanzado).map((d) => d.key);
  const advError = advKeys.some((k) => errors[k]);
  const ctx = { defs, values, defaults, errors, preview };
%>
<%- include('../partials/page-header', {
  heading: 'Configuración',
  lead: 'Se aplica a los estudios nuevos. Los ya analizados cambian sólo si los recalculás.',
}) %>
<% if (meta.updatedAt) { %><p class="cfg-meta muted small">Última modificación: <%= fmt.dateTime ? fmt.dateTime(meta.updatedAt) : fmt.date(meta.updatedAt) %></p><% } %>

<form method="post" action="/configuracion" class="cfg-form" id="cfg-form" data-settings-form novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="cfg-groups">
    <div class="cfg-columns">
      <%- include('group', { g: g('puntual'), nivel: 'basico', ...ctx }) %>
      <%- include('group', { g: g('riesgo'), nivel: 'basico', ...ctx }) %>
    </div>
    <div class="cfg-columns cfg-columns--3">
      <%- include('group', { g: g('seguimiento'), nivel: 'basico', ...ctx }) %>
      <%- include('group', { g: g('protocolo'), nivel: 'basico', ...ctx }) %>
      <%- include('group', { g: g('visualizacion'), nivel: 'basico', ...ctx }) %>
    </div>
  </div>

  <details class="card cfg-advanced" data-cfg-advanced<%= advError ? ' open' : '' %>>
    <summary class="cfg-advanced__summary">
      <span class="cfg-advanced__title">Avanzado</span>
      <span class="muted small">Grupos IWGDF, análisis por regiones, cámara y nombres de las imágenes. Conviene no cambiarlos.</span>
    </summary>
    <div class="cfg-advanced__body">
      <% ['riesgo', 'puntual', 'asimetria', 'protocolo', 'pronostico', 'visualizacion'].forEach((k) => { %>
      <%- include('group', { g: g(k), nivel: 'avanzado', ...ctx }) %>
      <% }) %>
    </div>
  </details>

  <div class="savebar" data-savebar hidden role="region" aria-label="Cambios sin guardar">
    <div class="savebar__inner">
      <span class="savebar__text"><%- include('../partials/icon', { name: 'info', size: 16 }) %><span><strong data-dirty-count>0</strong> <span data-dirty-word>cambios</span> sin guardar</span></span>
      <div class="savebar__actions">
        <button type="button" class="btn btn--ghost" data-discard>Descartar</button>
        <button type="submit" class="btn btn--primary">Guardar cambios</button>
      </div>
    </div>
  </div>
</form>

<section class="card cfg-recalc" aria-labelledby="recalc-title">
  <div class="cfg-recalc__text">
    <h2 id="recalc-title" class="card__title">Recalcular estudios</h2>
    <p class="muted small">Aplica la configuración guardada a los <strong class="num"><%= preview.total %></strong> estudios ya analizados. Las temperaturas no cambian.</p>
  </div>
  <button type="button" class="btn btn--ghost" data-modal-open="recalc-modal"><%- include('../partials/icon', { name: 'refresh', size: 18 }) %>Recalcular estudios</button>
</section>

<div class="modal" id="recalc-modal" hidden role="dialog" aria-modal="true" aria-labelledby="recalc-modal-title" aria-describedby="recalc-modal-desc">
  <div class="modal__backdrop" data-modal-close></div>
  <div class="modal__panel">
    <h2 id="recalc-modal-title" class="modal__title">¿Recalcular todos los estudios?</h2>
    <p id="recalc-modal-desc">Se recalculan <strong class="num"><%= preview.total %></strong> estudios con la configuración <strong>guardada</strong>, incluidos los que ya ve el paciente. Queda en la auditoría.</p>
    <p class="muted small" data-modal-dirty hidden>Tenés cambios sin guardar: no se usan. Guardalos primero si querés aplicarlos.</p>
    <form method="post" action="/configuracion/recalcular" class="modal__actions">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="button" class="btn btn--ghost" data-modal-close>Cancelar</button>
      <button type="submit" class="btn btn--primary">Sí, recalcular</button>
    </form>
  </div>
</div>

<script src="/js/settings.js" defer></script>
