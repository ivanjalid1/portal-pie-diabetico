<%
  // Mapas del análisis punto a punto (vista del médico/a): una pestaña por toma
  // y, si hay toma 2, una de cambio entre tomas. Parámetros: analysis, study.
  const A = analysis;
  const PW = A.puntual;
  const data = pw.payload(A);
  const srcId = `pw-${study.id}`;
  const fecha = (t) => (t.toma === 1 ? study.fechaToma1 : study.fechaHora);
  const rango = data.rango;
  const u = fmt.num(PW.umbralPixel, 1);
  const tabs = PW.tomas.map((t) => ({ id: `t${t.toma}`, label: `Toma ${t.toma}`, sub: fmt.date(fecha(t)) }));
  if (PW.cambio) tabs.push({ id: 'cambio', label: 'Cambio', sub: 'T2 − T1' });
  // TCI (índice de cambio térmico) de la última toma, si se calculó.
  const tciToma = PW.tomas.find((t) => t.toma === PW.tomaActual && t.tci && t.tci.mapas) || null;
  if (tciToma) tabs.push({ id: 'tci', label: 'TCI', sub: fmt.num(tciToma.tci.valor, 2) });
  const tciTicks = [-4, -2, 0, 2, 4].map((v) => [(v + 4) / 8, v > 0 ? `+${v}` : v < 0 ? `−${-v}` : '0']);
  const activa = `t${PW.tomaActual}`;
  const conTabs = tabs.length > 1;
  const DIV = 'linear-gradient(90deg, #2563a6 0%, #9dbbe0 30%, #f7f7f7 50%, #eba59f 70%, #d0342c 100%)';
  const divTicks = [-3, -2, -1, 0, 1, 2, 3].map((v) => [(v + 3) / 6, v > 0 ? `+${v}` : v < 0 ? `−${-v}` : '0']);
  const thrMarks = PW.umbralPixel < 3 ? [(3 - PW.umbralPixel) / 6, (3 + PW.umbralPixel) / 6] : [];
  const mid = (rango.lo + rango.hi) / 2;
  const tempTicks = [[0, fmt.num(rango.lo, 1)], [0.5, fmt.num(mid, 1)], [1, `${fmt.num(rango.hi, 1)} °C`]];
%>
<script type="application/json" id="<%= srcId %>" data-pw-data><%- pw.json(data) %></script>

<section class="card sr-visual" aria-labelledby="pw-title">
  <div class="sr-visual__head">
    <h2 id="pw-title" class="card__title">Mapas punto a punto</h2>
    <% if (conTabs) { %>
    <div class="sr-tabs" role="tablist" aria-label="Qué mostrar" data-sr-tabs>
      <% tabs.forEach((tb) => { const on = tb.id === activa; %>
      <button type="button" role="tab" class="sr-tabs__item" id="tab-<%= tb.id %>" aria-controls="panel-<%= tb.id %>" aria-selected="<%= on %>" tabindex="<%= on ? 0 : -1 %>"><%= tb.label %> <span class="num"><%= tb.sub %></span></button>
      <% }) %>
    </div>
    <% } else { %>
    <span class="muted small"><span class="toma-dot toma-dot--<%= PW.tomas[0].toma %>"></span>Toma <%= PW.tomas[0].toma %> · <span class="num"><%= fmt.date(fecha(PW.tomas[0])) %></span></span>
    <% } %>
  </div>

  <% PW.tomas.forEach((t) => { const m = t.metricas; const id = `t${t.toma}`; %>
  <div class="sr-panel" id="panel-<%= id %>"<% if (conTabs) { %> role="tabpanel" aria-labelledby="tab-<%= id %>"<% } %><%= conTabs && id !== activa ? ' hidden' : '' %>>
    <div class="sr-maps">
      <div class="sr-maps__group">
        <div class="sr-maps__pair">
          <figure class="pw-map">
            <canvas data-pw-map="<%= t.toma %>:izq" data-pw-src="<%= srcId %>" role="img" aria-label="Temperatura del pie izquierdo, toma <%= t.toma %>"></canvas>
            <figcaption>Pie izquierdo</figcaption>
          </figure>
          <figure class="pw-map">
            <canvas data-pw-map="<%= t.toma %>:der" data-pw-src="<%= srcId %>" role="img" aria-label="Temperatura del pie derecho, toma <%= t.toma %>"></canvas>
            <figcaption>Pie derecho</figcaption>
          </figure>
        </div>
        <%- include('scale', { gradient: thermal.PALETTE_CSS.alto_contraste, ticks: tempTicks, label: `Escala de temperatura de ${fmt.num(rango.lo, 1)} a ${fmt.num(rango.hi, 1)} °C` }) %>
        <p class="sr-caption">Temperatura de cada planta, con la misma escala para los dos pies.</p>
      </div>
      <div class="sr-maps__group sr-maps__group--dt">
        <figure class="pw-map pw-map--dt">
          <canvas data-pw-map="<%= t.toma %>:dt" data-pw-src="<%= srcId %>" role="img" aria-label="Diferencia izquierdo menos derecho por punto, toma <%= t.toma %><%= m ? `: ${fmt.num(m.areaCalientePct, 1)} % de la planta supera ${u} °C` : '' %>"></canvas>
          <figcaption>Diferencia izq. − der.</figcaption>
        </figure>
        <%- include('scale', { gradient: DIV, ticks: divTicks, marks: thrMarks, ends: ['der. más caliente', 'izq. más caliente'], label: 'Escala de diferencia de −3 a +3 °C' }) %>
        <p class="sr-caption">Rojo: el pie izquierdo está más caliente en ese punto; azul: el derecho (°C).</p>
        <ul class="sr-keys">
          <li><span class="sr-key sr-key--line" aria-hidden="true"></span>Más de <%= u %> °C</li>
          <li><span class="sr-key sr-key--hatch" aria-hidden="true"></span>Sin par</li>
          <li><span class="sr-key sr-key--spot" aria-hidden="true"></span>Mayor diferencia</li>
        </ul>
      </div>
    </div>
    <% if (m) { %>
    <p class="sr-panel__reading"><span class="toma-dot toma-dot--<%= t.toma %>"></span><span><strong>Toma <%= t.toma %>:</strong> <span class="num"><%= fmt.num(m.areaCalientePct, 0) %> %</span> de la planta con más de <%= u %> °C de diferencia. Mayor diferencia (<span class="num"><%= fmt.signed(m.hotspot.deltaT, 1) %> °C</span>) en <%= pw.hotspotTexto(m) %>.</span></p>
    <% } else { %>
    <p class="sr-panel__reading muted">No hubo puntos comparables en ambos pies.</p>
    <% } %>
  </div>
  <% }) %>

  <% if (PW.cambio) { %>
  <div class="sr-panel" id="panel-cambio" role="tabpanel" aria-labelledby="tab-cambio" hidden>
    <div class="sr-maps sr-maps--change">
      <div class="sr-maps__group">
        <div class="sr-maps__pair">
          <% [['izq', 'Pie izquierdo'], ['der', 'Pie derecho']].forEach(([k, label]) => { const c = PW.cambio[k]; %>
          <figure class="pw-map">
            <canvas data-pw-map="cambio:<%= k %>" data-pw-src="<%= srcId %>" role="img" aria-label="Cambio de temperatura toma 2 menos toma 1, <%= label.toLowerCase() %>"></canvas>
            <figcaption><%= label %><% if (c) { %><span class="sr-fig-sub">mediana <span class="num"><%= fmt.signed(c.mediana, 1) %> °C</span></span><% } %></figcaption>
          </figure>
          <% }) %>
        </div>
      </div>
      <div class="sr-maps__group sr-maps__group--side">
        <%- include('scale', { gradient: DIV, ticks: [[0, '−3'], [0.5, 'mediana'], [1, '+3 °C']], ends: ['subió menos', 'subió más'], label: 'Escala de cambio respecto de la mediana del pie, de −3 a +3 °C' }) %>
        <p class="sr-caption">Cómo cambió cada pie de la toma 1 a la toma 2, comparado con su propio cambio mediano (que refleja sobre todo el ambiente y el día). Rojo: esa zona se calentó más que el resto del pie; azul: menos o se enfrió.</p>
        <ul class="sr-keys">
          <li><span class="sr-key sr-key--hatch" aria-hidden="true"></span>Sin dato en una de las tomas</li>
        </ul>
        <% const ci = PW.cambio.izq; const cd = PW.cambio.der; if (ci && cd) { %>
        <p class="sr-panel__reading"><span>Cambio local (más de <%= fmt.num(PW.umbralCambio, 1) %> °C respecto de la mediana): <strong class="num"><%= fmt.num(ci.areaCambioLocalPct, 0) %> %</strong> del pie izquierdo y <strong class="num"><%= fmt.num(cd.areaCambioLocalPct, 0) %> %</strong> del derecho.</span></p>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  <% if (tciToma) { const T = tciToma.tci; const ref = T.referencia || {}; %>
  <div class="sr-panel" id="panel-tci" role="tabpanel" aria-labelledby="tab-tci" hidden>
    <div class="sr-maps sr-maps--change">
      <div class="sr-maps__group">
        <div class="sr-maps__pair">
          <% [['izq', 'Pie izquierdo'], ['der', 'Pie derecho']].forEach(([k, label]) => { %>
          <figure class="pw-map">
            <canvas data-pw-map="tci-<%= tciToma.toma %>:<%= k %>" data-pw-src="<%= srcId %>" role="img" aria-label="Desvío respecto del patrón de referencia, <%= label.toLowerCase() %>, toma <%= tciToma.toma %>"></canvas>
            <figcaption><%= label %><% if (T[k] !== null && T[k] !== undefined) { %><span class="sr-fig-sub">TCI <span class="num"><%= fmt.num(T[k], 2) %></span></span><% } %></figcaption>
          </figure>
          <% }) %>
        </div>
      </div>
      <div class="sr-maps__group sr-maps__group--side">
        <%- include('scale', { gradient: DIV, ticks: tciTicks, ends: ['más frío que la referencia', 'más caliente'], label: 'Escala de desvío respecto del patrón de referencia, de −4 a +4 °C' }) %>
        <p class="sr-caption">Diferencia de cada punto con el patrón de referencia (°C). Rojo: más caliente que la referencia; azul: más frío.</p>
        <ul class="sr-keys">
          <li><span class="sr-key sr-key--hatch" aria-hidden="true"></span>Sin dato en el pie o en la referencia</li>
        </ul>
        <p class="sr-panel__reading"><span><strong>TCI <span class="num"><%= fmt.num(T.valor, 2) %> °C</span></strong> (clase <%= T.clase %> de 5). Desvío medio por punto <span class="num"><%= fmt.signed(T.desvioMedio, 1) %> °C</span>. Referencia: <%= ref.fuente === 'cohorte' ? `${ref.miembros} pacientes simétricos de la cohorte${ref.looExcluido ? ', sin este paciente' : ''}` : 'pares de demostración' %>.</span></p>
      </div>
    </div>
  </div>
  <% } %>
</section>
